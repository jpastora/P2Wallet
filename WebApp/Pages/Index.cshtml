@section Scripts {
    <script src="~/js/ControlActions.js"></script>
    <script>
        // Inicializar controlador
        const controlActions = new ControlActions();
        
        // Smooth scrolling para enlaces de navegación
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });

        // Auto-inicializar carousel
        document.addEventListener('DOMContentLoaded', function() {
            // Hero carousel
            const heroCarousel = new bootstrap.Carousel(document.querySelector('#heroCarousel'), {
                interval: 5000,
                ride: 'carousel'
            });
            
            // Función para inicializar carruseles de contenido
            function initializeCarousel(selector, interval = 8000) {
                const carouselElement = document.querySelector(selector);
                if (carouselElement) {
                    const carousel = new bootstrap.Carousel(carouselElement, {
                        interval: interval,
                        ride: 'carousel',
                        pause: 'hover'
                    });
                    
                    // Pausar cuando el usuario hace hover en las cards
                    carouselElement.addEventListener('mouseenter', function() {
                        carousel.pause();
                    });
                    
                    carouselElement.addEventListener('mouseleave', function() {
                        carousel.cycle();
                    });
                    
                    return carousel;
                }
                return null;
            }
            
            // Inicializar carruseles de contenido
            initializeCarousel('#promocionesCarousel', 10000);
            initializeCarousel('#comerciosCarousel', 12000);
            initializeCarousel('#entidadesCarousel', 14000);
        });

        // Función para contactar comercio
        function contactarComercio(nombreComercio) {
            if (window.yaviController) {
                window.yaviController.ContactMerchant(nombreComercio);
            }
        }

        // Función para mostrar detalles de promoción
        function mostrarDetallesPromocion(tituloPromocion) {
            if (window.yaviController) {
                window.yaviController.ShowPromoDetails(tituloPromocion);
            }
        }
    </script>
}

