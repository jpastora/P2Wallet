<!-- PROMOCIONES -->
<section id="promos" class="py-5 bg-light-alt">
    <div class="container">
        <h2 class="section-title text-center">Promociones Destacadas</h2>
        @if (Model.Promociones.Any())
        {
            <!-- Carrusel de Promociones -->
            <div id="promocionesCarousel" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-inner">
                    @{
                        var promocionesChunks = Model.Promociones.Select((x, i) => new { Index = i, Value = x })
                                                                .GroupBy(x => x.Index / 3)
                                                                .Select(x => x.Select(v => v.Value).ToList())
                                                                .ToList();
                    }
                    
                    @for (int i = 0; i < promocionesChunks.Count; i++)
                    {
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <div class="row g-4">
                                @foreach (var promocion in promocionesChunks[i])
                                {
                                    <div class="col-md-4">
                                        <div class="card h-100">
                                            <img src="@promocion.ImagenUrl" class="card-img-top" alt="@promocion.Titulo" style="height: 200px; object-fit: cover;">
                                            <div class="card-body">
                                                <h5 class="card-title">@promocion.Titulo</h5>
                                                <p class="card-text">@promocion.Descripcion</p>
                                                
                                                @if (!string.IsNullOrEmpty(promocion.ComercioNombre) && promocion.ComercioNombre != "Yavi")
                                                {
                                                    <p class="small text-muted mb-2">
                                                        <i class="bi bi-shop"></i> @promocion.ComercioNombre
                                                    </p>
                                                }
                                                
                                                @if (promocion.PorcentajeDescuento > 0)
                                                {
                                                    <div class="mb-2">
                                                        <span class="badge bg-success">
                                                            @promocion.PorcentajeDescuento% de descuento
                                                        </span>
                                                        @if (!string.IsNullOrEmpty(promocion.TipoDescuento))
                                                        {
                                                            <span class="badge bg-info">@promocion.TipoDescuento</span>
                                                        }
                                                    </div>
                                                }
                                                
                                                <small class="text-muted">
                                                    <i class="bi bi-calendar"></i> Válida hasta: @promocion.FechaVencimiento.ToString("dd/MM/yyyy")
                                                </small>
                                            </div>
                                            <div class="card-footer bg-transparent border-0">
                                                @if (promocion.TipoPromocion == "Merchant")
                                                {
                                                    <a href="/Promotion/MerchantPromotionDetail?promotionId=@promocion.ID" class="btn btn-outline-primary w-100">
                                                        <i class="bi bi-eye me-2"></i>Ver Detalles
                                                    </a>
                                                }
                                                else if (promocion.TipoPromocion == "Financial")
                                                {
                                                    <a href="/Promotion/FinancialPromotionDetail?promotionId=@promocion.ID" class="btn btn-outline-primary w-100">
                                                        <i class="bi bi-eye me-2"></i>Ver Detalles
                                                    </a>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-outline-secondary w-100" disabled>
                                                        <i class="bi bi-info-circle me-2"></i>Información
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
                
                @if (promocionesChunks.Count > 1)
                {
                    <!-- Controles del carrusel -->
                    <button class="carousel-control-prev" type="button" data-bs-target="#promocionesCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Anterior</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#promocionesCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Siguiente</span>
                    </button>
                    
                    <!-- Indicadores -->
                    <div class="carousel-indicators">
                        @for (int i = 0; i < promocionesChunks.Count; i++)
                        {
                            <button type="button" data-bs-target="#promocionesCarousel" data-bs-slide-to="@i" 
                                    class="@(i == 0 ? "active" : "")" aria-label="Slide @(i + 1)"></button>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-gift fs-1 text-muted mb-3"></i>
                <h4 class="text-muted">Promociones próximamente</h4>
                <p class="text-muted">Estamos preparando ofertas exclusivas para ti.</p>
            </div>
        }
    </div>
</section>

