@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
}

<!-- HERO CAROUSEL -->
<div id="heroCarousel" class="carousel slide" data-bs-ride="carousel">
    <div class="carousel-inner">
        <div class="carousel-item active">
            <img src="https://res.cloudinary.com/dd4yjftn3/image/upload/c_pad,b_gen_fill,w_1600,h_600/v1752905596/Banner_Yavi.png" class="d-block w-100" alt="Hero 1">
            <div class="carousel-caption d-none d-md-block">
                <h5>Bienvenido a Yavi</h5>
                <p>La billetera digital que simplifica tu vida.</p>
                <a class="btn btn-primary" href="#servicios">Descubrir más</a>
            </div>
        </div>
        <div class="carousel-item">
            <img src="https://res.cloudinary.com/dd4yjftn3/image/upload/c_pad,b_gen_fill,w_1600,h_600/v1752905596/ChatGPT_Image_18_jul_2025_11_47_25_p.m._fjhrzk.png" class="d-block w-100" alt="Hero 2">
            <div class="carousel-caption d-none d-md-block">
                <h5>Pagos Instantáneos</h5>
                <p>Envía y recibe dinero al instante y sin complicaciones.</p>
                <a class="btn btn-primary" href="#promos">Ver Promociones</a>
            </div>
        </div>
        <div class="carousel-item">
            <img src="https://res.cloudinary.com/dd4yjftn3/image/upload/c_pad,b_gen_fill,w_1600,h_600/v1752905595/Banner_Store.png" class="d-block w-100" alt="Hero 3">
            <div class="carousel-caption d-none d-md-block">
                <h5>Conecta con Comercios</h5>
                <p>Explora descuentos exclusivos en comercios aliados.</p>
                <a class="btn btn-primary" href="#comercios">Ver Comercios</a>
            </div>
        </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon"></span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon"></span>
    </button>
</div>

<!-- SERVICIOS -->
<section id="servicios" class="py-5">
    <div class="container text-center">
        <h2 class="section-title">Nuestros Servicios</h2>
        <p class="mb-5">Soluciones integradas para usuarios, comercios y bancos.</p>
        <div class="row g-4">
            @foreach (var servicio in Model.Servicios)
            {
                <div class="col-md-4">
                    <div class="card p-4 h-100">
                        @if (!string.IsNullOrEmpty(servicio.Icono))
                        {
                            <i class="@servicio.Icono fs-1 text-primary mb-3"></i>
                        }
                        <h5>@servicio.Titulo</h5>
                        <p>@servicio.Descripcion</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- SOBRE NOSOTROS -->
<section id="sobre" class="py-5 bg-light-alt">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h2 class="section-title">Pagos rápidos y control inteligente</h2>
                <p>En Yavi conectamos usuarios, comercios y bancos con una experiencia digital simple y segura.</p>
                <ul class="list-unstyled">
                    <li><i class="bi bi-check-circle text-success me-2"></i>Transacciones instantáneas</li>
                    <li><i class="bi bi-check-circle text-success me-2"></i>Máxima seguridad</li>
                    <li><i class="bi bi-check-circle text-success me-2"></i>Facilidad de uso</li>
                    <li><i class="bi bi-check-circle text-success me-2"></i>Soporte 24/7</li>
                </ul>
            </div>
            <div class="col-md-6 text-center">
                <img src="https://picsum.photos/seed/about/500/350" class="img-fluid rounded" alt="Sobre Yavi">
            </div>
        </div>
    </div>
</section>

<!-- POR QUÉ ELEGIRNOS -->
<section id="por-que" class="py-5">
    <div class="container text-center">
        <h2 class="section-title">¿Por qué elegir Yavi?</h2>
        <p class="mb-5">Experiencia intuitiva, seguridad y convenios exclusivos.</p>
        <div class="row g-4">
            <div class="col-md-3">
                <div class="text-center">
                    <i class="bi bi-shield-check fs-1 text-primary mb-3"></i>
                    <h5>Seguridad</h5>
                    <p>Tecnología de punta para proteger tus transacciones</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="text-center">
                    <i class="bi bi-lightning fs-1 text-primary mb-3"></i>
                    <h5>Rapidez</h5>
                    <p>Pagos instantáneos sin complicaciones</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="text-center">
                    <i class="bi bi-people fs-1 text-primary mb-3"></i>
                    <h5>Comunidad</h5>
                    <p>Red amplia de comercios y entidades aliadas</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="text-center">
                    <i class="bi bi-headset fs-1 text-primary mb-3"></i>
                    <h5>Soporte</h5>
                    <p>Atención al cliente disponible siempre</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- PROMOCIONES -->
<section id="promos" class="py-5 bg-light-alt">
    <div class="container">
        <h2 class="section-title text-center">Promociones Destacadas</h2>
        @if (Model.Promociones.Any())
        {
            <div class="row g-4">
                @foreach (var promocion in Model.Promociones)
                {
                    <div class="col-md-4">
                        <div class="card h-100">
                            <img src="@promocion.ImagenUrl" class="card-img-top" alt="@promocion.Titulo">
                            <div class="card-body">
                                <h5 class="card-title">@promocion.Titulo</h5>
                                <p class="card-text">@promocion.Descripcion</p>
                                
                                @if (!string.IsNullOrEmpty(promocion.ComercioNombre) && promocion.ComercioNombre != "Yavi")
                                {
                                    <p class="small text-muted mb-2">
                                        <i class="bi bi-shop"></i> @promocion.ComercioNombre
                                    </p>
                                }
                                
                                @if (promocion.PorcentajeDescuento > 0)
                                {
                                    <div class="mb-2">
                                        <span class="badge bg-success">
                                            @promocion.PorcentajeDescuento% de descuento
                                        </span>
                                        @if (!string.IsNullOrEmpty(promocion.TipoDescuento))
                                        {
                                            <span class="badge bg-info">@promocion.TipoDescuento</span>
                                        }
                                    </div>
                                }
                                
                                <small class="text-muted">
                                    <i class="bi bi-calendar"></i> Válida hasta: @promocion.FechaVencimiento.ToString("dd/MM/yyyy")
                                </small>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-gift fs-1 text-muted mb-3"></i>
                <h4 class="text-muted">Promociones próximamente</h4>
                <p class="text-muted">Estamos preparando ofertas exclusivas para ti.</p>
            </div>
        }
    </div>
</section>

<!-- COMERCIOS AFILIADOS -->
<section id="comercios" class="py-5">
    <div class="container">
        <h2 class="section-title text-center">Comercios Afiliados</h2>
        @if (Model.ComerciosAfiliados.Any())
        {
            <div class="row g-4">
                @foreach (var comercio in Model.ComerciosAfiliados)
                {
                    <div class="col-md-4">
                        <div class="card h-100 text-center p-3">
                            <img src="@comercio.ImagenUrl" class="card-img-top" alt="@comercio.Nombre">
                            <div class="card-body">
                                <h5 class="card-title">@comercio.Nombre</h5>
                                <span class="badge bg-secondary mb-2">@comercio.Categoria</span>
                                <p class="card-text">@comercio.Descripcion</p>
                                
                                @if (!string.IsNullOrEmpty(comercio.Telefono) || !string.IsNullOrEmpty(comercio.Email))
                                {
                                    <div class="mt-3 small text-muted">
                                        @if (!string.IsNullOrEmpty(comercio.Telefono))
                                        {
                                            <div><i class="bi bi-telephone"></i> @comercio.Telefono</div>
                                        }
                                        @if (!string.IsNullOrEmpty(comercio.Email))
                                        {
                                            <div><i class="bi bi-envelope"></i> @comercio.Email</div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-shop fs-1 text-muted mb-3"></i>
                <h4 class="text-muted">Comercios próximamente</h4>
                <p class="text-muted">Estamos incorporando más comercios aliados para brindarte mejores beneficios.</p>
            </div>
        }
    </div>
</section>

<!-- ENTIDADES FINANCIERAS -->
<section id="bancos" class="py-5 bg-light-alt">
    <div class="container">
        <h2 class="section-title text-center">Entidades Financieras</h2>
        @if (Model.EntidadesFinancieras.Any())
        {
            <div class="row g-4">
                @foreach (var entidad in Model.EntidadesFinancieras)
                {
                    <div class="col-md-4">
                        <div class="card h-100 text-center p-3">
                            <img src="@entidad.ImagenUrl" class="card-img-top" alt="@entidad.Nombre">
                            <div class="card-body">
                                <h5 class="card-title">@entidad.Nombre</h5>
                                <p class="card-text">@entidad.Descripcion</p>
                                
                                @if (!string.IsNullOrEmpty(entidad.Telefono) || !string.IsNullOrEmpty(entidad.Email))
                                {
                                    <div class="mt-3 small text-muted">
                                        @if (!string.IsNullOrEmpty(entidad.Telefono))
                                        {
                                            <div><i class="bi bi-telephone"></i> @entidad.Telefono</div>
                                        }
                                        @if (!string.IsNullOrEmpty(entidad.Email))
                                        {
                                            <div><i class="bi bi-envelope"></i> @entidad.Email</div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-bank fs-1 text-muted mb-3"></i>
                <h4 class="text-muted">Entidades financieras próximamente</h4>
                <p class="text-muted">Estamos estableciendo alianzas con más entidades financieras para mejorar tu experiencia.</p>
            </div>
        }
    </div>
</section>

<!-- PREGUNTAS FRECUENTES -->
<section id="faq" class="py-5">
    <div class="container">
        <h2 class="section-title text-center">Preguntas Frecuentes</h2>
        <div class="accordion" id="faqAccordion">
            @for (int i = 0; i < Model.PreguntasFrecuentes.Count; i++)
            {
                var pregunta = Model.PreguntasFrecuentes[i];
                var collapseId = $"collapse{i + 1}";
                var headerId = $"faq{i + 1}";
                var isFirst = i == 0;
                
                <div class="accordion-item">
                    <h2 class="accordion-header" id="@headerId">
                        <button class="accordion-button @(isFirst ? "" : "collapsed")" type="button" 
                                data-bs-toggle="collapse" data-bs-target="#@collapseId" 
                                aria-expanded="@(isFirst ? "true" : "false")" aria-controls="@collapseId">
                            @pregunta.Pregunta
                        </button>
                    </h2>
                    <div id="@collapseId" class="accordion-collapse collapse @(isFirst ? "show" : "")" 
                         aria-labelledby="@headerId" data-bs-parent="#faqAccordion">
                        <div class="accordion-body">
                            @pregunta.Respuesta
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- ESTADÍSTICAS -->
<section class="py-5 bg-primary text-white">
    <div class="container">
        <div class="row text-center">
            <div class="col-md-3">
                <div class="mb-3">
                    <i class="bi bi-people fs-1"></i>
                    <h3 class="mt-2">@Model.ComerciosAfiliados.Count(c => c.Categoria != "Información")+</h3>
                    <p>Comercios Afiliados</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="mb-3">
                    <i class="bi bi-bank fs-1"></i>
                    <h3 class="mt-2">@Model.EntidadesFinancieras.Count(e => e.Nombre.Contains("Banco") || e.Nombre.Contains("Financiera"))+</h3>
                    <p>Entidades Financieras</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="mb-3">
                    <i class="bi bi-gift fs-1"></i>
                    <h3 class="mt-2">@Model.Promociones.Count(p => p.PorcentajeDescuento > 0)+</h3>
                    <p>Promociones Activas</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="mb-3">
                    <i class="bi bi-shield-check fs-1"></i>
                    <h3 class="mt-2">100%</h3>
                    <p>Seguridad Garantizada</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- LLAMADA A LA ACCIÓN -->
<section class="py-5">
    <div class="container text-center">
        <h2>¿Listo para comenzar con Yavi?</h2>
        <p class="lead">Únete a miles de usuarios que ya disfrutan de la comodidad de Yavi</p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a href="/Register/UserRegister" class="btn btn-primary btn-lg">
                <i class="bi bi-person-plus me-2"></i>Registrarse como Usuario
            </a>
           <!-- <a href="/Register/MerchantRegister" class="btn btn-outline-primary btn-lg">
                <i class="bi bi-shop me-2"></i>Registrar Comercio
             </a>-->
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/ControlActions.js"></script>
    <script>
        // Inicializar controlador
        const controlActions = new ControlActions();
        
        // Smooth scrolling para enlaces de navegación
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });

        // Auto-inicializar carousel
        document.addEventListener('DOMContentLoaded', function() {
            const carousel = new bootstrap.Carousel(document.querySelector('#heroCarousel'), {
                interval: 5000,
                ride: 'carousel'
            });
        });

        // Función para contactar comercio
        function contactarComercio(nombreComercio) {
            if (window.yaviController) {
                window.yaviController.ContactMerchant(nombreComercio);
            }
        }

        // Función para mostrar detalles de promoción
        function mostrarDetallesPromocion(tituloPromocion) {
            if (window.yaviController) {
                window.yaviController.ShowPromoDetails(tituloPromocion);
            }
        }
    </script>
}
