@using Microsoft.Extensions.Configuration  
@inject IConfiguration Configuration  

<!DOCTYPE html>  
<html lang="es">  
<head>  
    <meta charset="UTF-8">  
    <meta name="viewport" content="width=device-width, initial-scale=1.0">  
    <title>@ViewData["Title"] - Yavi – La Wallet Digital</title>  

      
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />  
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />  
    <link href="https://cdn.datatables.net/2.2.2/css/dataTables.dataTables.min.css" rel="stylesheet" />  

</head>  
<body>
    @inject IConfiguration Configuration
    <nav class="navbar navbar-expand-lg navbar-dark">  
        <div class="container">  
            <a class="navbar-brand fw-bold" href="/">Yavi</a>  
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">  
                <span class="navbar-toggler-icon"></span>  
            </button>  
            <div class="collapse navbar-collapse" id="navbarNav">  
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">  
                    <partial name="_MainMenuPartial" />  
                </ul>  
                <div class="dropdown">  
                    <partial name="_LoginRegisterPartial" />  
                </div>  
            </div>  
        </div>  
    </nav>  

    <main role="main" class="pb-3">  
        @RenderBody()  
    </main>  

    <footer>  
        <div class="container">  
            <div class="row">  
                <div class="col-md-3 mb-3">  
                    <h5>Yavi</h5>  
                    <ul class="list-unstyled">  
                        <li><a href="/">Inicio</a></li>  
                        <li><a href="#servicios">Servicios</a></li>  
                        <li><a href="#sobre">Nosotros</a></li>  
                        <li><a href="#contacto">Contacto</a></li>  
                    </ul>  
                </div>  
                <div class="col-md-3 mb-3">  
                    <h5>Productos</h5>  
                    <ul class="list-unstyled">  
                        <li><a href="#promos">Promos</a></li>  
                        <li><a href="#comercios">Comercios</a></li>  
                        <li><a href="#bancos">Bancos</a></li>  
                        <li><a href="#faq">FAQ</a></li>  
                    </ul>  
                </div>  
                <div class="col-md-3 mb-3">  
                    <h5>Empresa</h5>  
                    <ul class="list-unstyled">  
                        <li><a href="#sobre">Nosotros</a></li>  
                        <li><a href="#careers">Carreras</a></li>  
                        <li><a href="#blog">Blog</a></li>  
                    </ul>  
                </div>  
                <div class="col-md-3 mb-3">  
                    <h5>Legal</h5>  
                    <ul class="list-unstyled">  
                        <li><a href="#terms">Términos de uso</a></li>  
                        <li><a href="#privacy">Política de privacidad</a></li>  
                    </ul>  
                </div>  
            </div>  
            <div class="text-center mt-3">  
                &copy; 2025 Yavi. Todos los derechos reservados.  
            </div>  
        </div>  
    </footer>  

    <script src="~/lib/jquery/dist/jquery.js"></script>  
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.js"></script>  
    <script src="https://cdn.datatables.net/2.2.2/js/dataTables.min.js"></script>  
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>  
    <script src="~/js/ControlActions.js" asp-append-version="true"></script>

    <script async src="https://maps.googleapis.com/maps/api/js?key=@Configuration["GoogleMaps:ApiKey"]&libraries=places,marker&callback=initMap"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>  
</html>