@using Microsoft.AspNetCore.Identity
@{
    var email = User.Identity?.Name;
    var isAdmin = false;
    
    if (!string.IsNullOrEmpty(email))
    {
        var userManager = new CoreApp.UserManager();
        var currentUser = userManager.RetrieveUserByEmail(new DTOs.User { Email = email });
        isAdmin = currentUser != null && currentUser.Role == "Admin";
    }
}

@if (isAdmin)
{
    <div class="d-flex" id="wrapper">
        <!-- Sidebar -->
        <div class="sidebar bg-dark text-white p-3">
            <h4 class="mb-4">Yavi <span class="text-primary">Admin</span></h4>
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link text-white @(ViewContext.RouteData.Values["page"]?.ToString() == "/Administrator/AdministratorPannel" ? "active" : "")" 
                       href="/Administrator/AdministratorPannel">
                        <i class="bi bi-speedometer2 me-2"></i>Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white @(ViewContext.RouteData.Values["page"]?.ToString() == "/Administrator/AdministratorPanelUsers" ? "active" : "")"
                       href="/Administrator/AdministratorPanelUsers">
                        <i class="bi bi-people me-2"></i>Usuarios
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white @(ViewContext.RouteData.Values["page"]?.ToString() == "/Administrator/AdministratorPanelMerchants" ? "active" : "")" 
                       href="/Administrator/AdministratorPanelMerchants">
                        <i class="bi bi-shop me-2"></i>Comercios
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white @(ViewContext.RouteData.Values["page"]?.ToString() == "/Administrator/AdministratorPanelFinancialEntities" ? "active" : "")" 
                       href="/Administrator/AdministratorPanelFinancialEntities">
                        <i class="bi bi-bank me-2"></i>Entidades Bancarias
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white @(ViewContext.RouteData.Values["page"]?.ToString() == "/Administrator/AdministratorPanelPromotions" ? "active" : "")" 
                       href="/Administrator/AdministratorPanelPromotions">
                        <i class="bi bi-megaphone me-2"></i>Promociones
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white @(ViewContext.RouteData.Values["page"]?.ToString() == "/Administrator/AdministratorPanelTransactions" ? "active" : "")" 
                       href="/Administrator/AdministratorPanelTransactions">
                        <i class="bi bi-cash-stack me-2"></i>Transacciones
                    </a>
                </li>
                <li class="nav-item mt-4">
                    <a class="nav-link text-warning" href="/User/UserProfile">
                        <i class="bi bi-person me-2"></i>Mi Perfil
                    </a>
                </li>
                <li class="nav-item mt-4">
                    <a class="nav-link text-warning" href="/User/UserPanel">
                        <i class="bi-arrow-left"></i>Regresar
                    </a>
                </li>
                <li class="nav-item">
                    <form method="post" action="/logout" class="d-inline">
                        <button type="submit" class="nav-link text-danger border-0 bg-transparent w-100 text-start">
                            <i class="bi bi-box-arrow-right me-2"></i>Cerrar Sesión
                        </button>
                    </form>
                </li>
            </ul>
        </div>

        <style>
            .sidebar .nav-link.active {
                background-color: rgba(255, 255, 255, 0.1);
                border-radius: 0.375rem;
            }
            .sidebar .nav-link:hover {
                background-color: rgba(255, 255, 255, 0.05);
                border-radius: 0.375rem;
            }
        </style>
    </div>
}
