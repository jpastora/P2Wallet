@using Microsoft.AspNetCore.Identity
@{
    var currentPath = Context.Request.Path.Value?.ToLower() ?? "";
}
<!-- FAB Escanear QR -->
<button id="escanearQR" class="btn btn-primary fab">
    <i class="bi bi-qr-code-scan fs-4"></i>
</button>

<!-- Barra Navegación Inferior -->
<nav class="nav-bottom bg-white shadow-lg d-flex justify-content-between">
    <a href="/User/UserPanel" class="nav-item flex-fill text-center @(currentPath == "/user/userpanel" ? "active" : "")"><i class="bi bi-house fs-5"></i><br>Inicio</a>
    <a href="/User/UserBankAccount" class="nav-item flex-fill text-center @(currentPath == "/user/userbankaccount" ? "active" : "")"><i class="bi bi-credit-card-2-front fs-5"></i><br>Cuentas</a>
    <a href="/User/Statistics" class="nav-item flex-fill text-center @(currentPath == "/user/statistics" ? "active" : "")"><i class="bi bi-pie-chart fs-5"></i><br>Estadísticas</a>
    <a href="/User/UserProfile" class="nav-item flex-fill text-center @(currentPath == "/user/userprofile" ? "active" : "")"><i class="bi bi-person fs-5"></i><br>Perfil</a>
    <form method="post" asp-page="/Logout" class="flex-fill m-0 p-0" style="display: flex; align-items: center; justify-content: center;">
        <button type="submit" class="nav-item text-center text-danger w-100" style="background:none;border:none;padding:0;"><i class="bi bi-box-arrow-right fs-5"></i><br>Salir</button>
    </form>
</nav>