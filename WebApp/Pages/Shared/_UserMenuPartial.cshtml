@using Microsoft.AspNetCore.Identity
@{
    var currentPath = Context.Request.Path.Value?.ToLower() ?? "";
    
    // Verificar si el usuario es Admin
    var isAdmin = false;
    var email = User.Identity?.Name;
    
    if (!string.IsNullOrEmpty(email))
    {
        var userManager = new CoreApp.UserManager();
        var currentUser = userManager.RetrieveUserByEmail(new DTOs.User { Email = email });
        isAdmin = currentUser != null && currentUser.Role == "Admin";
    }
}

<!-- FAB Escanear QR -->
<button id="escanearQR" class="btn btn-primary fab">
    <i class="bi bi-qr-code-scan fs-4"></i>
</button>

<!-- Barra Navegación Inferior -->
<nav class="nav-bottom bg-white shadow-lg d-flex justify-content-between @(isAdmin ? "has-admin" : "")">
    <a href="/User/UserPanel" class="nav-item flex-fill text-center @(currentPath == "/user/userpanel" ? "active" : "")">
        <i class="bi bi-house fs-5"></i><br>Inicio
    </a>
    <a href="/User/UserBankAccount" class="nav-item flex-fill text-center @(currentPath == "/user/userbankaccount" ? "active" : "")">
        <i class="bi bi-credit-card-2-front fs-5"></i><br>Cuentas
    </a>
    <a href="/User/UserTransactionID" class="nav-item flex-fill text-center @(currentPath == "/user/usertransactionid" ? "active" : "")">
        <i class="bi bi-card-checklist fs-5"></i><br>Transacciones
    </a>
    
    @if (isAdmin)
    {
        <a href="/Administrator/AdministratorPannel" class="nav-item flex-fill text-center admin-btn @(currentPath.StartsWith("/administrator") ? "active" : "")" title="Panel de Administración">
            <i class="bi bi-shield-check fs-5"></i><br>Admin
        </a>
    }
    
    <a href="/User/UserProfile" class="nav-item flex-fill text-center @(currentPath == "/user/userprofile" ? "active" : "")">
        <i class="bi bi-person fs-5"></i><br>Perfil
    </a>
    
    <form method="post" asp-page="/Logout" class="flex-fill m-0 p-0" style="display: flex; align-items: center; justify-content: center;">
        <button type="submit" class="nav-item text-center text-danger w-100" style="background:none;border:none;padding:8px 4px;" title="Cerrar Sesión">
            <i class="bi bi-box-arrow-right fs-5"></i><br>Salir
        </button>
    </form>
</nav>

@if (isAdmin)
{
    <script>
        // Agregar un pequeño efecto visual cuando se carga el botón de admin
        document.addEventListener('DOMContentLoaded', function() {
            const adminBtn = document.querySelector('.admin-btn');
            if (adminBtn) {
                adminBtn.style.animation = 'fadeInUp 0.5s ease-out';
            }
        });
    </script>
    
    <style>
        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
}