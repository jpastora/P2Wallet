@page
@model WebApp.Pages.Register.UserRegisterModel

@{
    ViewData["Title"] = "Registro de Usuario";
}

<script src="~/js/User.js"></script>

<div class="container py-5">
    <h2 class="mb-4 text-center">Registro de Nuevo Usuario</h2>
    <form id="registerForm" class="needs-validation" novalidate>
        <div class="">
            <div class="row mb-3">
                <div class="col-md-6">
                    <label for="firstName" class="form-label">Nombre</label>
                    <input type="text" class="form-control" id="txtFirstName" ColumnDataName="FirstName" required />
                    <div class="invalid-feedback">El nombre es obligatorio.</div>
                </div>
                <div class="col-md-6">
                    <label for="lastName" class="form-label">Apellido</label>
                    <input type="text" class="form-control" id="txtLastName" ColumnDataName="LastName" required />
                    <div class="invalid-feedback">El apellido es obligatorio.</div>
                </div>
            </div>
            <div class="mb-3">
                <label for="email" class="form-label">Correo Electrónico</label>
                <input type="email" class="form-control" id="txtEmail" ColumnDataName="Email" required />
                <div class="invalid-feedback">Introduce un correo válido.</div>
            </div>
            <div class="mb-3 d-flex">
                <button type="button" class="btn btn-outline-primary me-2" id="btnSendOTP">Enviar OTP para verificar email</button>
                <input type="text" class="form-control" id="otp" placeholder="Código OTP Email" style="max-width: 200px;" required disabled />
                <div class="invalid-feedback">El OTP es obligatorio.</div>
            </div>
            <div class="mb-3">
                <label for="phone" class="form-label">Teléfono</label>
                <div class="input-group">
                    <span class="input-group-text">+</span>
                    <input type="text" class="form-control" id="txtCountryCode" value="506" style="max-width: 80px;" required />
                    <input type="text" class="form-control" id="txtPhone" ColumnDataName="MobilePhone" required />
                </div>
                <div class="invalid-feedback">El teléfono debe ser correcto e incluir el código de país.</div>
            </div>
            <div class="mb-3 d-flex">
                <button type="button" class="btn btn-outline-success me-2" id="btnSendSmsOTP">Enviar OTP SMS para verificar Teléfono</button>
                <input type="text" class="form-control" id="smsOtp" placeholder="Código OTP SMS" style="max-width: 200px;" required disabled />
                <div class="invalid-feedback">El OTP SMS es obligatorio.</div>
            </div>
            <div class="mb-3">
                <label for="password" class="form-label">Contraseña</label>
                <input type="password" class="form-control" id="txtPassword" ColumnDataName="Password" minlength="8" required />
                <div class="invalid-feedback">La contraseña debe tener al menos 8 caracteres.</div>
            </div>
            <div class="mb-3">
                <label for="confirmPassword" class="form-label">Confirmar Contraseña</label>
                <input type="password" class="form-control" id="txtConfirmPassword" required />
                <div class="invalid-feedback">Las contraseñas no coinciden.</div>
            </div>
            <div class="mb-3">
                <label for="autocomplete" class="form-label">Dirección</label>
                <input id="autocomplete" type="text" class="form-control" placeholder="Escribe tu dirección o lugar..." autocomplete="off" required />
                <div class="invalid-feedback">La dirección es obligatoria.</div>
            </div>
            <div class="mb-3 d-flex align-items-end">
                <button class="btn btn-light w-100" type="button" id="btnSearchAddress">Selecionar dirección</button>
            </div>
            <input type="hidden" id="txtLatitude" ColumnDataName="Latitude">
            <input type="hidden" id="txtLongitude" ColumnDataName="Longitude">
            <div class="mb-3">
                <div id="map-container" class="position-relative">
                    <div id="map" style="height: 450px; width: 100%; border-radius: 8px;"></div>
                </div>
                <small class="form-text text-muted">Busca, haz clic en el mapa o arrastra el pin para ajustar tu ubicación.</small>
            </div>
            <div class="mb-4">
                <button type="submit" class="btn btn-primary w-100">Registrarse</button>
            </div>
        </div>
    </form>
    <div id="alertPlaceholder" class="mt-4"></div>
</div>

@section Scripts {
    @inject Microsoft.Extensions.Configuration.IConfiguration Configuration
    <script type="text/javascript">
        let map, marker, geocoder, placeAutocomplete;

        function initMap() {
            const latInput = document.getElementById('txtLatitude');
            const lngInput = document.getElementById('txtLongitude');
            const mapDiv = document.getElementById('map');
            const addressInput = document.getElementById('autocomplete');
            const searchButton = document.getElementById('btnSearchAddress');
            const initialLocation = { lat: 9.934739, lng: -84.087502 };

            geocoder = new google.maps.Geocoder();
            map = new google.maps.Map(mapDiv, {
                zoom: 14,
                center: initialLocation,
                mapId: 'YAVI_REGISTER_MAP'
            });

            // Advanced Marker (nuevo recomendado)
            marker = new google.maps.marker.AdvancedMarkerElement({
                map,
                position: initialLocation,
                gmpDraggable: true
            });

            latInput.value = initialLocation.lat;
            lngInput.value = initialLocation.lng;

            // NUEVO AUTOCOMPLETE con PlaceAutocompleteElement
            placeAutocomplete = new google.maps.places.PlaceAutocompleteElement();
            placeAutocomplete.input = addressInput;
            placeAutocomplete.addEventListener('gmp-placechange', (event) => {
                const place = event.detail.place;
                if (place && place.geometry && place.geometry.location) {
                    const location = place.geometry.location;
                    map.setCenter(location);
                    marker.position = location;
                    latInput.value = location.lat();
                    lngInput.value = location.lng();
                }
            });

            // Buscar dirección manualmente
            searchButton.addEventListener('click', function () {
                if (addressInput.value) {
                    geocoder.geocode({ address: addressInput.value }, function (results, status) {
                        if (status === 'OK' && results[0]) {
                            const loc = results[0].geometry.location;
                            map.setCenter(loc);
                            marker.position = loc;
                            latInput.value = loc.lat();
                            lngInput.value = loc.lng();
                        } else {
                            alert('La dirección no se encontró: ' + status);
                        }
                    });
                }
            });

            // Buscar al presionar Enter
            addressInput.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    searchButton.click();
                }
            });

            // Actualizar lat/lng al mover el AdvancedMarker
            marker.addListener('dragend', (event) => {
                const pos = event.latLng;
                latInput.value = pos.lat();
                lngInput.value = pos.lng();
                geocoder.geocode({ location: pos }, (results, status) => {
                    if (status === 'OK' && results[0]) {
                        addressInput.value = results[0].formatted_address;
                    }
                });
            });

            // Clic en el mapa mueve el marcador
            map.addListener('click', (event) => {
                marker.position = event.latLng;
                latInput.value = event.latLng.lat();
                lngInput.value = event.latLng.lng();
                geocoder.geocode({ location: event.latLng }, (results, status) => {
                    if (status === 'OK' && results[0]) {
                        addressInput.value = results[0].formatted_address;
                    }
                });
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
            'use strict';
            const form = document.getElementById('registerForm');
            const emailInput = document.getElementById('txtEmail');
            const countryCodeInput = document.getElementById('txtCountryCode');
            const phoneInput = document.getElementById('txtPhone');
            const pwdInput = document.getElementById('txtPassword');
            const confirmPwdInput = document.getElementById('txtConfirmPassword');
            const alertPlaceholder = document.getElementById('alertPlaceholder');
            const userController = new UserViewController();

            function showAlert(message, type = 'danger') {
                alertPlaceholder.innerHTML = `<div class="alert alert-${type} alert-dismissible" role="alert">${message}<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>`;
            }

            // --- FUNCIONES DE VALIDACIÓN ESPECÍFICAS Y CORRECTAS ---
            function validateEmail(email) {
                var input = document.createElement('input');
                input.type = 'email';
                input.value = email;
                return input.checkValidity();
            }

            function validatePhone(phone) {
                const regex = /^\d+$/;
                return regex.test(phone);
            }

            // --- VALIDACIÓN EN TIEMPO REAL ---
            emailInput.addEventListener('input', () => {
                emailInput.classList.toggle('is-invalid', !validateEmail(emailInput.value));
            });

            phoneInput.addEventListener('input', () => {
                phoneInput.classList.toggle('is-invalid', !validatePhone(phoneInput.value));
            });

            confirmPwdInput.addEventListener('input', () => {
                confirmPwdInput.classList.toggle('is-invalid', pwdInput.value !== confirmPwdInput.value);
            });

            // --- LÓGICA MEJORADA DE OTP EMAIL Y SMS ---
            const btnSendOTP = document.getElementById('btnSendOTP');
            const otpInput = document.getElementById('otp');
            let otpSentTo = null;

            const btnSendSmsOTP = document.getElementById('btnSendSmsOTP');
            const smsOtpInput = document.getElementById('smsOtp');
            let smsOtpSentTo = null;

            btnSendOTP.addEventListener('click', async function () {
                const email = emailInput.value.trim();
                if (!validateEmail(email)) {
                    emailInput.classList.add('is-invalid');
                    showAlert('Ingresa un correo válido antes de solicitar el OTP.', 'danger');
                    return;
                }
                btnSendOTP.disabled = true;
                btnSendOTP.textContent = 'Enviando...';
                try {
                    const response = await fetch('https://p2wallet-api-eyefddgeeda9c2fk.eastus-01.azurewebsites.net/api/mail/enviar?email=' + encodeURIComponent(email), {
                        method: 'POST'
                    });
                    let data = null;
                    try { data = await response.json(); } catch { data = {}; }
                    if (response.ok) {
                        showAlert((data.message || 'OTP enviado a tu correo. Revisa tu bandeja de entrada o spam.'), 'success');
                        otpInput.disabled = false;
                        emailInput.readOnly = true;
                        otpSentTo = email;
                        btnSendOTP.textContent = 'OTP Enviado';
                    } else {
                        showAlert((data.message || 'Error enviando OTP. Intenta de nuevo.'), 'danger');
                        btnSendOTP.disabled = false;
                        btnSendOTP.textContent = 'Enviar OTP para verificar la cuenta';
                    }
                } catch {
                    showAlert('Error enviando OTP. Intenta de nuevo.', 'danger');
                    btnSendOTP.disabled = false;
                    btnSendOTP.textContent = 'Enviar OTP para verificar la cuenta';
                }
            });

            btnSendSmsOTP.addEventListener('click', async function () {
                const countryCode = countryCodeInput.value.trim();
                const phone = phoneInput.value.trim();
                const fullPhone = `+${countryCode}${phone}`;
                if (!/^\+\d{1,3}\d{8,}$/.test(fullPhone)) {
                    phoneInput.classList.add('is-invalid');
                    showAlert('Ingresa un teléfono válido con código de país.', 'danger');
                    return;
                }
                btnSendSmsOTP.disabled = true;
                btnSendSmsOTP.textContent = 'Enviando...';
                try {
                    const response = await fetch('https://p2wallet-api-eyefddgeeda9c2fk.eastus-01.azurewebsites.net/api/sms/enviar-sms?telefono=' + encodeURIComponent(fullPhone), {
                        method: 'POST'
                    });
                    let data = null;
                    try { data = await response.json(); } catch { data = {}; }
                    if (response.ok) {
                        showAlert((data.message || 'OTP enviado por SMS. Revisa tu teléfono.'), 'success');
                        smsOtpInput.disabled = false;
                        phoneInput.readOnly = true;
                        smsOtpSentTo = fullPhone;
                        btnSendSmsOTP.textContent = 'OTP SMS Enviado';
                    } else {
                        showAlert((data.message || 'Error enviando OTP SMS. Intenta de nuevo.'), 'danger');
                        btnSendSmsOTP.disabled = false;
                        btnSendSmsOTP.textContent = 'Enviar OTP por SMS';
                    }
                } catch {
                    showAlert('Error enviando OTP SMS. Intenta de nuevo.', 'danger');
                    btnSendSmsOTP.disabled = false;
                    btnSendSmsOTP.textContent = 'Enviar OTP por SMS';
                }
            });

            async function verificarOTP(email, otp) {
                const response = await fetch('https://p2wallet-api-eyefddgeeda9c2fk.eastus-01.azurewebsites.net/api/mail/verificar-otp?email=' + encodeURIComponent(email) + '&otp=' + encodeURIComponent(otp), {
                    method: 'POST'
                });
                const data = await response.json();
                if (!response.ok) {
                    showAlert(data.message || 'El código OTP es incorrecto o expiró.', 'danger');
                    return false;
                }
                showAlert(data.message || 'OTP verificado con éxito.', 'success');
                return data.valido === true;
            }

            async function verificarSmsOTP(phone, otp) {
                const response = await fetch('https://p2wallet-api-eyefddgeeda9c2fk.eastus-01.azurewebsites.net/api/sms/verificar-otp?telefono=' + encodeURIComponent(phone) + '&otp=' + encodeURIComponent(otp), {
                    method: 'POST'
                });
                const data = await response.json();
                if (!response.ok) {
                    showAlert(data.message || 'El código OTP SMS es incorrecto o expiró.', 'danger');
                    return false;
                }
                showAlert(data.message || 'OTP SMS verificado con éxito.', 'success');
                return data.valido === true;
            }

            // Si el usuario cambia el correo o teléfono, reiniciar OTPs
            emailInput.addEventListener('input', () => {
                emailInput.readOnly = false;
                btnSendOTP.disabled = false;
                btnSendOTP.textContent = 'Enviar OTP para verificar la cuenta';
                otpInput.value = '';
                otpInput.disabled = true;
                otpSentTo = null;
            });
            otpInput.disabled = true;

            phoneInput.addEventListener('input', () => {
                phoneInput.readOnly = false;
                btnSendSmsOTP.disabled = false;
                btnSendSmsOTP.textContent = 'Enviar OTP por SMS';
                smsOtpInput.value = '';
                smsOtpInput.disabled = true;
                smsOtpSentTo = null;
            });
            smsOtpInput.disabled = true;

            // --- VALIDACIÓN AL ENVIAR EL FORMULARIO ---
            form.addEventListener('submit', async (e) => {
                e.preventDefault();

                let isValid = true;

                // Validar todos los campos requeridos
                form.querySelectorAll('[required]').forEach(input => {
                    if (!input.value.trim()) {
                        input.classList.add('is-invalid');
                        isValid = false;
                    } else {
                        input.classList.remove('is-invalid');
                    }
                });

                // Validar formato de Email
                if (emailInput.value && !validateEmail(emailInput.value)) {
                    emailInput.classList.add('is-invalid');
                    isValid = false;
                }

                // Validar formato de Teléfono
                const countryCode = countryCodeInput.value.trim();
                const phone = phoneInput.value.trim();
                const fullPhone = `+${countryCode}${phone}`;
                if (!validatePhone(phone) || !/^\+\d{1,3}\d{8,}$/.test(fullPhone)) {
                    phoneInput.classList.add('is-invalid');
                    isValid = false;
                }

                // Validar coincidencia de contraseñas
                if (pwdInput.value !== confirmPwdInput.value) {
                    confirmPwdInput.classList.add('is-invalid');
                    isValid = false;
                }

                // Validar OTP EMAIL
                if (!otpInput.value || !otpSentTo || emailInput.value !== otpSentTo) {
                    otpInput.classList.add('is-invalid');
                    showAlert('Debes solicitar y validar el código OTP para este correo.', 'danger');
                    return;
                }
                const otpValido = await verificarOTP(emailInput.value, otpInput.value);
                if (!otpValido) {
                    otpInput.classList.add('is-invalid');
                    showAlert('El código OTP es incorrecto o expiró.', 'danger');
                    return;
                }
                otpInput.classList.remove('is-invalid');

                // Validar OTP SMS
                if (!smsOtpInput.value || !smsOtpSentTo || fullPhone !== smsOtpSentTo) {
                    smsOtpInput.classList.add('is-invalid');
                    showAlert('Debes solicitar y validar el código OTP SMS para este teléfono.', 'danger');
                    return;
                }
                const smsOtpValido = await verificarSmsOTP(fullPhone, smsOtpInput.value);
                if (!smsOtpValido) {
                    smsOtpInput.classList.add('is-invalid');
                    showAlert('El código OTP SMS es incorrecto o expiró.', 'danger');
                    return;
                }
                smsOtpInput.classList.remove('is-invalid');

                if (!isValid) {
                    showAlert('Por favor, corrige los campos marcados en rojo.', 'danger');
                    return;
                }

                // Si todo es válido, puedes proceder a enviar los datos.
                userController.Create();
                form.reset();
                emailInput.readOnly = false;
                btnSendOTP.disabled = false;
                btnSendOTP.textContent = 'Enviar codigo de validación de mail';
                otpInput.disabled = true;
                otpSentTo = null;
                phoneInput.readOnly = false;
                btnSendSmsOTP.disabled = false;
                btnSendSmsOTP.textContent = 'Enviar codigo de validación de teléfono';
                smsOtpInput.disabled = true;
                smsOtpSentTo = null;


            });
        });
    </script>

    <script src="https://maps.googleapis.com/maps/api/js?key=@(Configuration["GoogleMaps:ApiKey"])&libraries=places,marker,geocoding&callback=initMap"
            async defer loading="async"></script>
}