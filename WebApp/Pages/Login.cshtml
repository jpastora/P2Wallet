@page
@model WebApp.Pages.loginModel
@{
    ViewData["Title"] = "Inicio";
}

<!-- CONTENIDO LOGIN -->
<div class="container py-5">
    <div class="row">
        <div class="col-md-6 col-lg-4 mx-auto">
            <div class="card p-4 shadow-sm">
                <h2 class="text-center mb-4">Iniciar Sesión</h2>
                <form method="post" asp-antiforgery="true" class="needs-validation" novalidate>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Correo Electrónico</label>
                        <input asp-for="Email" type="email" class="form-control" required />
                        <div class="invalid-feedback">Por favor, introduce un correo válido.</div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Contraseña</label>
                        <input asp-for="Password" type="password" class="form-control" required />
                        <div class="invalid-feedback">Por favor, introduce tu contraseña.</div>
                    </div>
                    <div class="mb-3 form-check d-flex justify-content-between align-items-center">
                        <div>
                            <input asp-for="RememberMe" type="checkbox" class="form-check-input" />
                            <label class="form-check-label" asp-for="RememberMe">Recuérdame</label>
                        </div>
                        <a href="/User/UserPasswordRecovery">¿Olvidaste tu contraseña?</a>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Ingresar</button>
                    <hr class="divider" data-content="o" />
                </form>
                <script>
                    // Auto login desde sessionStorage
                    document.addEventListener('DOMContentLoaded', () => {
                        const email = sessionStorage.getItem('autoLoginEmail');
                        const password = sessionStorage.getItem('autoLoginPassword');

                        if (email && password) {
                            document.querySelector('input[name="Email"]').value = email;
                            document.querySelector('input[name="Password"]').value = password;
                            sessionStorage.removeItem('autoLoginEmail');
                            sessionStorage.removeItem('autoLoginPassword');
                            document.querySelector('form').submit();
                        }
                    });
                </script>
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger mt-2">@Model.ErrorMessage</div>
                }
                <p class="mt-3 text-center">
                    ¿No tienes una cuenta?
                    <a href="/Register/UserRegister">Regístrate</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', async () => {
            const email = sessionStorage.getItem('autoLoginEmail');
            const password = sessionStorage.getItem('autoLoginPassword');

            if (email && password) {
                // Ocultar el formulario mientras inicia sesión
                document.querySelector('form').style.display = 'none'

                // Promesa de delay
                const delay = new Promise(resolve => setTimeout(resolve, 50000));

                // Promesa del fetch login
                const loginPromise = fetch('https://p2wallet-api-eyefddgeeda9c2fk.eastus-01.azurewebsites.net/api/User/Login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email, password })
                });

                try {
                    // Esperar ambas promesas (mín 5s y login)
                    const [response] = await Promise.all([loginPromise, delay]);

                    if (!response.ok) {
                        console.logo('Entramos aqui..')
                        // Mostrar formulario si el login automático falla
                        document.querySelector('form').style.display = 'block';
                        loadingContainer.remove();
                    }
                } catch (err) {
                    console.error('Error en login automático', err);
                    document.querySelector('form').style.display = 'block';
                    loadingContainer.remove();
                } finally {
                    // Limpiar para evitar repetir el login automático
                    sessionStorage.removeItem('autoLoginEmail');
                    sessionStorage.removeItem('autoLoginPassword');
                }
            }
        });
    </script>
}



