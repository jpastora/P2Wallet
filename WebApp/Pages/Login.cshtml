@page
@model WebApp.Pages.loginModel
@{
    ViewData["Title"] = "Inicio";
}

<!-- CONTENIDO LOGIN -->
<div class="container py-5">
    <div class="row">
        <div class="col-md-6 col-lg-4 mx-auto">
            <div class="card p-4 shadow-sm">
                <h2 class="text-center mb-4">Iniciar Sesión</h2>
                <form method="post" asp-antiforgery="true" class="needs-validation" novalidate>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Correo Electrónico</label>
                        <input asp-for="Email" type="email" class="form-control" required />
                        <div class="invalid-feedback">Por favor, introduce un correo válido.</div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Contraseña</label>
                        <input asp-for="Password" type="password" class="form-control" required />
                        <div class="invalid-feedback">Por favor, introduce tu contraseña.</div>
                    </div>
                    <div class="mb-3 form-check d-flex justify-content-between align-items-center">
                        <div>
                            <input asp-for="RememberMe" type="checkbox" class="form-check-input" />
                            <label class="form-check-label" asp-for="RememberMe">Recuérdame</label>
                        </div>
                        <a href="/User/UserPasswordRecovery">¿Olvidaste tu contraseña?</a>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Ingresar</button>
                    <hr class="divider" data-content="o" />
                </form>
                <script>
                    document.addEventListener('DOMContentLoaded', () => {
                        const email = sessionStorage.getItem('autoLoginEmail');
                        if (email) {
                            document.querySelector('input[name="Email"]').value = email;
                            sessionStorage.removeItem('autoLoginEmail');
                        }
                    });
                </script>
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger mt-2">@Model.ErrorMessage</div>
                }
                <p class="mt-3 text-center">
                    ¿No tienes una cuenta?
                    <a href="/Register/UserRegister">Regístrate</a>
                </p>
            </div>
        </div>
    </div>
</div>
