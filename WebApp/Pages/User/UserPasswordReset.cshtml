@page
@model WebApp.Pages.User.UserPasswordResetModel
@{
    ViewData["Title"] = "Restablecer contraseña";
}
<div class="container py-5">
    <div class="row">
        <div class="col-md-6 col-lg-5 mx-auto">
            <div class="card p-4 shadow-sm">
                <h2 class="text-center mb-3">Restablecer Contraseña</h2>
                @if (!string.IsNullOrEmpty(Model.SuccessMessage))
                {
                    <div class="alert alert-success">@Model.SuccessMessage</div>
                }
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger">@Model.ErrorMessage</div>
                }
                <form method="post" class="needs-validation" novalidate>
                    <input type="hidden" asp-for="Email" />
                    <input type="hidden" asp-for="Token" />
                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label">Nueva Contraseña</label>
                        <input asp-for="NewPassword" type="password" class="form-control" required minlength="8" />
                        <div class="invalid-feedback">La contraseña debe tener al menos 8 caracteres.</div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label">Confirmar Contraseña</label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" required />
                        <div class="invalid-feedback">Las contraseñas no coinciden.</div>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 mt-3">Restablecer Contraseña</button>
                </form>
            </div>
            <div class="text-center mt-3">
                <a href="/Login">Volver a Iniciar Sesión</a>
            </div>
        </div>
    </div>
</div>
