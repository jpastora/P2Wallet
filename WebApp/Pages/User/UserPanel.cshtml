@page
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@model WebApp.Pages.User.UserPanelModel
@{
    var user = Model.CurrentUser;
    var cuentas = Model.UserAccounts;
}

<!-- Encabezado -->
<header class="p-4 text-center">
    <img src="@(user?.ProfilePhotoUrl ?? "https://picsum.photos/seed/40/40")" class="rounded-circle mb-2" alt="Usuario" width="100" height="100"/>
    <h4>Hola, @(user?.FirstName ?? "Usuario")</h4>
</header>

<!-- Saldo -->
<section class="container mb-4">
    <div class="card text-center shadow saldo-card">
        <div class="card-body">
            <h6 class="text-muted">Saldo Total Disponible</h6>
            <h2 class="text-primary fw-bold">₡1,234.000.56</h2>
            <div class="d-flex justify-content-around mt-4">
                <button class="btn btn-outline-primary"><i class="bi bi-arrow-up-circle"></i> Enviar</button>
                <button class="btn btn-outline-success"><i class="bi bi-arrow-down-circle"></i> Recibir</button>
                <button class="btn btn-outline-warning"><i class="bi bi-credit-card"></i> Pagar</button>
            </div>
        </div>
    </div>
</section>

<!-- Mis Cuentas -->
<section class="container mb-4">
    <h5>Mis Cuentas</h5>
    <ul class="list-group">
        @if (cuentas != null && cuentas.Count > 0)
        {
            foreach (var cuenta in cuentas)
            {
                <li class="list-group-item d-flex align-items-center">
                    <img src="https://picsum.photos/seed/banco2/40/40" class="me-3" alt="Banco" />
                    IBAN: @cuenta.IBAN
                </li>
            }
        }
        else
        {
            <li class="list-group-item">No tienes cuentas registradas.</li>
        }
        <li class="list-group-item">
            <a href="/User/UserBankAccount" id="agregarCuenta" class="text-decoration-none text-primary"><i class="bi bi-plus-circle"></i> Agregar nueva cuenta</a>
        </li>
    </ul>
</section>

<!-- Actividad Reciente -->
<section class="container mb-5">
    <h5>Actividad Reciente</h5>
    <ul class="list-group">
        @if (Model.LastTransactions != null && Model.LastTransactions.Count > 0)
        {
            foreach (var txn in Model.LastTransactions)
            {
                var merchant = Model.MerchantNames.ContainsKey(txn.MerchantID) ? Model.MerchantNames[txn.MerchantID] : "-";
                var iban = Model.AccountIBANs.ContainsKey(txn.BankAccountID) ? Model.AccountIBANs[txn.BankAccountID] : "-";
                var bank = "-";
                if (Model.AccountIBANs.ContainsKey(txn.BankAccountID))
                {
                    var accountManager = new CoreApp.BankAccountManager();
                    var acc = accountManager.RetrieveBankAccountById(txn.BankAccountID);
                    if (acc != null && Model.BankNames.ContainsKey(acc.FinancialEntityID))
                    {
                        bank = Model.BankNames[acc.FinancialEntityID];
                    }
                }
                <li class="list-group-item d-flex flex-column flex-md-row justify-content-between align-items-md-center">
                    <div>
                        <i class="bi bi-shop me-2 text-secondary"></i>
                        <strong>@merchant</strong>
                        <span class="text-muted small ms-2">IBAN: @iban</span>
                        <span class="text-muted small ms-2">Banco: @bank</span>
                    </div>
                    <div class="d-flex align-items-center mt-2 mt-md-0">
                        <span class="me-3" style="font-family: 'Segoe UI Symbol', 'Arial Unicode MS', Arial;">₡</span>@txn.NetAmount.ToString("N2")
                        <small class="text-muted d-block ms-3">@txn.TransactionStatus</small>
                        <a asp-page="/User/UserTransactionInvoice" asp-route-id="@txn.ID" class="btn btn-sm btn-outline-info ms-3">Ver Detalle</a>
                    </div>
                </li>
            }
        }
        else
        {
            <li class="list-group-item">No hay transacciones recientes.</li>
        }
        <li class="list-group-item text-center">
            <a href="/User/UserTransactionID" id="verHistorial">Ver todo el historial</a>
        </li>
    </ul>
</section>
