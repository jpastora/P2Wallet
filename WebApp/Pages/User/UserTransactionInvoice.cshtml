@page "{id:int}"
@model WebApp.Pages.User.UserTransactionInvoiceModel
@{
    var txn = Model.Transaction;
    var user = Model.CurrentUser;
    var merchant = Model.MerchantName;
    var account = Model.IBAN;
    var promotion = Model.PromotionApplied;
    var discountApplied = Model.DiscountAmount;
    string EstadoEspanol(string status) => status switch
    {
        "Completed" => "Completada",
        "Pending" => "Pendiente",
        "Failed" => "Fallida",
        "Cancelled" => "Cancelada",
        _ => status
    };
}

<link rel="stylesheet" href="~/css/UserTransactionInvoice.css" />

<div class="container py-4 mb-5">
    <div class="factura-box">
        <div class="factura-header">
            Comprobante de Pago
        </div>
        @if (txn != null)
        {
            <div class="factura-info-row">
                <div class="factura-info-list">
                    <div><span>ID Transacción:</span> #@txn.ID</div>
                    <div><span>Usuario:</span> @user?.FirstName @user?.LastName</div>
                    <div><span>Comercio:</span> @merchant</div>
                    <div><span>Cuenta:</span> @account</div>
                    <div><span>Estado:</span> @EstadoEspanol(txn.TransactionStatus)</div>
                </div>
                <div class="factura-fecha">
                    <span>Fecha:</span> @txn.Timestamp.ToString("dd/MM/yyyy HH:mm")
                </div>
            </div>
            <div class="factura-table-responsive">
                <table class="factura-table">
                    <tbody>
                        @{
                            var originalNetAmountCalculated = discountApplied > 0 ? txn.NetAmount + discountApplied : txn.NetAmount;
                        }
                        @if (discountApplied > 0)
                        {
                            <tr>
                                <td><strong>Monto de Venta Original</strong></td>
                                <td class="factura-monto">₡@originalNetAmountCalculated.ToString("N2")</td>
                            </tr>
                            <tr>
                                <td>Descuento Aplicado</td>
                                <td class="factura-monto factura-descuento">-₡@discountApplied.ToString("N2")</td>
                            </tr>
                            <tr>
                                <td><strong>Subtotal (después descuento)</strong></td>
                                <td class="factura-monto">₡@txn.NetAmount.ToString("N2")</td>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <td><strong>Monto de Venta</strong></td>
                                <td class="factura-monto">₡@txn.NetAmount.ToString("N2")</td>
                            </tr>
                        }
                        @if (promotion != null)
                        {
                            <tr>
                                <td>Promoción Aplicada</td>
                                <td>@promotion.Name (@promotion.TypeText)</td>
                            </tr>
                            @if (promotion.DiscountPercentage > 0)
                            {
                                <tr>
                                    <td>Porcentaje de descuento</td>
                                    <td>@promotion.DiscountPercentage.ToString("N2")%</td>
                                </tr>
                            }
                        }
                        <tr>
                            <td>Impuesto Aplicado (@txn.TaxRateApplied.ToString("N1")%)</td>
                            <td class="factura-monto factura-impuesto">₡@txn.SalesTaxAmount.ToString("N2")</td>
                        </tr>
                        <tr class="factura-total-row">
                            <td><strong>Total Pagado</strong></td>
                            <td class="factura-monto"><strong>₡@txn.GrossAmount.ToString("N2")</strong></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="factura-btn-row">
                <a asp-page="/User/UserTransactionID" class="factura-btn">Volver al historial</a>
            </div>
        }
        else
        {
            <div class="alert alert-danger">No se encontró la transacción.</div>
        }
    </div>
</div>
