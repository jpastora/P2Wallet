@page "{id:int}"
@model WebApp.Pages.User.UserTransactionInvoiceModel
@{
    var txn = Model.Transaction;
    var user = Model.CurrentUser;
    var merchant = Model.MerchantName;
    var iban = Model.IBAN;
    var bank = Model.BankName;
    var discountName = Model.DiscountName;
    var discountPercentage = Model.DiscountPercentage;
    var discountAmount = Model.DiscountAmount;
    var discountSource = Model.DiscountSource;
    string EstadoEspanol(string status) => status switch
    {
        "Completed" => "Completada",
        "Pending" => "Pendiente",
        "Failed" => "Fallida",
        "Cancelled" => "Cancelada",
        _ => status
    };
}

<link rel="stylesheet" href="~/css/UserTransactionInvoice.css" />

<div class="container py-4 mb-5">
    <div class="factura-box">
        <div class="factura-header">
            Factura de Transacción
        </div>
        @if (txn != null)
        {
            <div class="factura-info-row">
                <div class="factura-info-list">
                    <div><span>ID Transacción:</span> @txn.ID</div>
                    <div><span>Usuario:</span> @user?.FirstName @user?.LastName</div>
                    <div><span>Comercio:</span> @merchant</div>
                    <div><span>Cuenta:</span> @iban</div>
                    <div><span>Banco:</span> @bank</div>
                    <div><span>Estado:</span> @EstadoEspanol(txn.TransactionStatus)</div>
                </div>
                <div class="factura-fecha">
                    <span>Fecha:</span> @txn.Timestamp.ToString("dd/MM/yyyy HH:mm")
                </div>
            </div>
            <div class="factura-table-responsive">
            <table class="factura-table">
                <tbody>
                    <tr>
                        <td><strong>Monto Bruto</strong></td>
                        <td class="factura-monto">&#8353;@txn.GrossAmount.ToString("N2")</td>
                    </tr>
                    @if (discountAmount.HasValue && discountAmount.Value > 0)
                    {
                        <tr>
                            <td>Descuento en colones</td>
                            <td class="factura-monto factura-descuento">-&#8353;@discountAmount.Value.ToString("N2")</td>
                        </tr>
                    }
                    @if (discountPercentage.HasValue && discountPercentage.Value > 0)
                    {
                        <tr>
                            <td>Porcentaje de descuento</td>
                            <td>@discountPercentage.Value.ToString("N2")%</td>
                        </tr>
                    }
                    @if (!string.IsNullOrEmpty(discountName))
                    {
                        <tr>
                            <td>Nombre del descuento</td>
                            <td>@discountName</td>
                        </tr>
                    }
                    @if (!string.IsNullOrEmpty(discountSource))
                    {
                        <tr>
                            <td>Comercio/Entidad del descuento</td>
                            <td>@discountSource</td>
                        </tr>
                    }
                    <tr>
                        <td>Impuestos</td>
                        <td class="factura-monto factura-impuesto">&#8353;@txn.SalesTaxAmount.ToString("N2")</td>
                    </tr>
                    <tr class="factura-total-row">
                        <td><strong>Monto Final</strong></td>
                        <td class="factura-monto"><strong>&#8353;@txn.NetAmount.ToString("N2")</strong></td>
                    </tr>
                </tbody>
            </table>
            </div>
            <div class="factura-btn-row">
                <a asp-page="/User/UserTransactionID" class="factura-btn">Volver al historial</a>
            </div>
        }
        else
        {
            <div class="alert alert-danger">No se encontró la transacción.</div>
        }
    </div>
</div>
