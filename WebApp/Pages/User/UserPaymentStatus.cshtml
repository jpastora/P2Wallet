@page
@model WebApp.Pages.User.UserPaymentStatusModel
@{
    ViewData["Title"] = "Estado de Solicitudes de Pago";
}

<div class="container py-4 mb-5">
    <h2 class="mb-4">Estado de Solicitudes de Pago</h2>
    
    @if (!string.IsNullOrEmpty(Model.MerchantName))
    {
        <p class="text-muted mb-4">Comercio: <strong>@Model.MerchantName</strong></p>
    }

    <!-- Resumen de estadísticas -->
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card">
                <div class="card-body text-center">
                    <h4 class="mb-1">@Model.TotalRequests</h4>
                    <small class="text-muted">Total Solicitudes</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card">
                <div class="card-body text-center">
                    <h4 class="mb-1 text-warning">@Model.ActiveCount</h4>
                    <small class="text-muted">Pendientes</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card">
                <div class="card-body text-center">
                    <h4 class="mb-1 text-success">@Model.CompletedCount</h4>
                    <small class="text-muted">Completadas</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card">
                <div class="card-body text-center">
                    <h4 class="mb-1">₡@Model.TodaySales.ToString("N0")</h4>
                    <small class="text-muted">Ventas de Hoy</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Navegación -->
    <div class="mb-4">
        <div class="d-flex flex-wrap gap-2">
            <a href="/Merchant/CreatePaymentRequest?merchantId=@Model.MerchantID" class="btn btn-primary">
                Nueva Solicitud
            </a>
            <button type="button" class="btn btn-outline-primary" onclick="refreshPayments()">
                Actualizar
            </button>
            <a href="/User/UserBusinessManager" class="btn btn-outline-secondary">
                Volver a Mis Comercios
            </a>
        </div>
    </div>

    <!-- Pestañas simples -->
    <ul class="nav nav-tabs mb-4" id="statusTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="active-tab" data-bs-toggle="tab" data-bs-target="#active" type="button" role="tab">
                Pendientes (@Model.ActiveCount)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="completed-tab" data-bs-toggle="tab" data-bs-target="#completed" type="button" role="tab">
                Completadas (@Model.CompletedCount)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="expired-tab" data-bs-toggle="tab" data-bs-target="#expired" type="button" role="tab">
                Expiradas (@Model.ExpiredCount)
            </button>
        </li>
    </ul>

    <!-- Contenido de las pestañas -->
    <div class="tab-content" id="statusTabsContent">
        <!-- Solicitudes Pendientes -->
        <div class="tab-pane fade show active" id="active" role="tabpanel" aria-labelledby="active-tab">
            @if (Model.ActiveRequests.Any())
            {
                <div class="row">
                    @foreach (var request in Model.ActiveRequests.OrderByDescending(r => r.CreatedAt))
                    {
                        <div class="col-lg-4 col-md-6 mb-4">
                            <div class="card">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <h6 class="card-title mb-0">@request.Description</h6>
                                        <span class="badge @request.StatusBadgeClass">@request.StatusText</span>
                                    </div>
                                    
                                    <div class="text-center mb-3">
                                        <img src="@request.QRCodeUrl" alt="QR Code" class="img-fluid" style="max-width: 120px;" />
                                    </div>
                                    
                                    <div class="mb-3">
                                        <small class="text-muted">Monto:</small> <strong>₡@request.GrossAmount.ToString("N2")</strong><br>
                                        <small class="text-muted">Código:</small> <code>@request.PaymentRequestCode</code><br>
                                        <small class="text-muted">Fecha:</small> @request.CreatedAt.ToString("dd/MM/yyyy HH:mm")<br>
                                        @if (!string.IsNullOrEmpty(request.TimeRemaining))
                                        {
                                            <small class="text-muted">Tiempo restante:</small> <span class="text-warning">@request.TimeRemaining</span>
                                        }
                                    </div>
                                    
                                    <div class="d-grid gap-2">
                                        <button type="button" class="btn btn-outline-primary btn-sm" 
                                                onclick="showQR('@request.PaymentRequestCode', '@request.QRCodeUrl')">
                                            Ver QR Grande
                                        </button>
                                        <button type="button" class="btn btn-outline-danger btn-sm" 
                                                data-payment-code="@request.PaymentRequestCode"
                                                data-description="@request.Description"
                                                data-amount="@request.GrossAmount.ToString("N2")"
                                                onclick="handleCancelClick(this)">
                                            Cancelar Solicitud
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-info text-center">
                    <h5>No hay solicitudes pendientes</h5>
                    <p class="mb-3">Las solicitudes de pago activas aparecerán aquí</p>
                    <a href="/Merchant/CreatePaymentRequest?merchantId=@Model.MerchantID" class="btn btn-primary">
                        Crear Primera Solicitud
                    </a>
                </div>
            }
        </div>

        <!-- Solicitudes Completadas -->
        <div class="tab-pane fade" id="completed" role="tabpanel" aria-labelledby="completed-tab">
            @if (Model.CompletedRequests.Any())
            {
                <div class="card">
                    <div class="card-header">
                        <h6 class="mb-0">Solicitudes Completadas - Total: ₡@Model.TotalSales.ToString("N2")</h6>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Fecha</th>
                                        <th>Descripción</th>
                                        <th>Código</th>
                                        <th class="text-end">Monto Bruto</th>
                                        <th class="text-end">Monto Neto</th>
                                        <th class="text-center">Estado</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var request in Model.CompletedRequests.OrderByDescending(r => r.CreatedAt).Take(20))
                                    {
                                        <tr>
                                            <td>@request.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>@request.Description</td>
                                            <td><code>@request.PaymentRequestCode</code></td>
                                            <td class="text-end">₡@request.GrossAmount.ToString("N2")</td>
                                            <td class="text-end">₡@request.NetAmount.ToString("N2")</td>
                                            <td class="text-center">
                                                <span class="badge @request.StatusBadgeClass">@request.StatusText</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        
                        @if (Model.CompletedRequests.Count > 20)
                        {
                            <div class="text-center mt-3">
                                <small class="text-muted">Mostrando los 20 pagos más recientes de @Model.CompletedRequests.Count total</small>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info text-center">
                    <h5>No hay solicitudes completadas</h5>
                    <p>Los pagos completados aparecerán aquí cuando los clientes paguen las solicitudes</p>
                </div>
            }
        </div>

        <!-- Solicitudes Expiradas/Canceladas -->
        <div class="tab-pane fade" id="expired" role="tabpanel" aria-labelledby="expired-tab">
            @if (Model.ExpiredRequests.Any())
            {
                <div class="card">
                    <div class="card-header">
                        <h6 class="mb-0">Solicitudes Expiradas/Canceladas</h6>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Fecha</th>
                                        <th>Descripción</th>
                                        <th>Código</th>
                                        <th class="text-end">Monto</th>
                                        <th class="text-center">Estado</th>
                                        <th>Expiró</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var request in Model.ExpiredRequests.OrderByDescending(r => r.CreatedAt).Take(15))
                                    {
                                        <tr>
                                            <td>@request.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>@request.Description</td>
                                            <td><code>@request.PaymentRequestCode</code></td>
                                            <td class="text-end">₡@request.GrossAmount.ToString("N2")</td>
                                            <td class="text-center">
                                                <span class="badge @request.StatusBadgeClass">@request.StatusText</span>
                                            </td>
                                            <td>
                                                @if (request.ExpiresAt.HasValue)
                                                {
                                                    @request.ExpiresAt.Value.ToString("dd/MM/yyyy HH:mm")
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Sin expiración</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        
                        @if (Model.ExpiredRequests.Count > 15)
                        {
                            <div class="text-center mt-3">
                                <small class="text-muted">Mostrando los 15 más recientes de @Model.ExpiredRequests.Count total</small>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info text-center">
                    <h5>No hay solicitudes expiradas</h5>
                    <p>Las solicitudes expiradas aparecerán aquí</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal para mostrar QR grande -->
<div class="modal fade" id="qrModal" tabindex="-1" aria-labelledby="qrModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="qrModalLabel">Código QR de Pago</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <img id="modalQRImage" src="" alt="QR Code" class="img-fluid mb-3" style="max-width: 300px;" />
                <p><strong>Código:</strong> <span id="modalQRCode"></span></p>
                <div class="d-grid gap-2">
                    <button type="button" class="btn btn-outline-primary" onclick="downloadModalQR()">
                        Descargar
                    </button>
                    <button type="button" class="btn btn-outline-secondary" onclick="printModalQR()">
                        Imprimir
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Formulario oculto para cancelación -->
<form id="cancelPaymentForm" method="post" asp-page-handler="CancelRequest" style="display: none;">
    <input type="hidden" id="cancelPaymentCode" name="paymentCode" />
</form>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/UserPaymentStatus.js"></script>
    
    <script>
        // Configurar el manager con datos del servidor
        document.addEventListener('DOMContentLoaded', function() {
            if (window.UserPaymentStatusManager) {
                window.UserPaymentStatusManager.configure({
                    merchantName: @Html.Raw(Json.Serialize(Model.MerchantName)),
                    activeCount: @Model.ActiveCount,
                    message: @Html.Raw(Json.Serialize(Model.Message))
                });
            }
        });
        
        // Función auxiliar para manejar click de cancelación
        function handleCancelClick(button) {
            const paymentCode = button.getAttribute('data-payment-code');
            const description = button.getAttribute('data-description');
            const amount = button.getAttribute('data-amount');
            
            if (window.UserPaymentStatusManager) {
                window.UserPaymentStatusManager.confirmCancelPayment(paymentCode, description, amount);
            }
        }
    </script>
}