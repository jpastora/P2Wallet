@page
@model WebApp.Pages.User.UserTransactionIDModel
@{
    var transacciones = Model.UserTransactions;
    var user = Model.CurrentUser;
    var merchantNames = Model.MerchantNames;
    var accountIBANs = Model.AccountIBANs;
    var bankNames = Model.BankNames;
    string EstadoEspanol(string status) => status switch
    {
        "Completed" => "Completada",
        "Pending" => "Pendiente",
        "Failed" => "Fallida",
        "Cancelled" => "Cancelada",
        _ => status
    };
}

<link rel="stylesheet" href="~/css/UserTransactionID.css" />

<!-- Estilos específicos para esta página -->
<style>
    /* Estilos para los encabezados ordenables */
    .table th a {
        display: block;
        padding: 0.5rem;
        margin: -0.5rem;
        border-radius: 0.25rem;
        transition: background-color 0.15s ease-in-out;
    }

    .table th a:hover {
        background-color: rgba(0, 0, 0, 0.05);
    }

    .table th.table-active {
        background-color: var(--bs-primary-bg-subtle);
        border-color: var(--bs-primary-border-subtle);
    }

    .table th.table-active a {
        color: var(--bs-primary) !important;
        font-weight: 600;
    }

    /* Mejorar el aspecto de los iconos de ordenamiento */
    .bi-arrow-up-down {
        opacity: 0.4;
        transition: opacity 0.15s ease-in-out;
    }

    .table th:hover .bi-arrow-up-down {
        opacity: 0.8;
    }

    .bi-arrow-up, .bi-arrow-down {
        color: var(--bs-primary);
    }

    /* Estilos para códigos IBAN */
    code.small {
        background-color: var(--bs-light);
        color: var(--bs-dark);
        padding: 0.2rem 0.4rem;
        border-radius: 0.25rem;
        font-size: 0.8rem;
    }

    /* Resaltar filas al hacer hover */
    .table tbody tr:hover {
        background-color: var(--bs-light);
    }
</style>

<div class="container py-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Mis Transacciones</h2>
        @if (transacciones != null && transacciones.Count > 0)
        {
            <div class="text-muted">
                <small>Total: @transacciones.Count transacciones</small>
            </div>
        }
    </div>

    @if (transacciones != null && transacciones.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover">
                <thead class="table-light">
                    <tr>
                        <th class="@Model.GetSortHeaderClass("ID")">
                            <a asp-page="/User/UserTransactionID" 
                               asp-route-sortBy="ID" 
                               asp-route-sortDirection="@Model.IdSort" 
                               class="text-decoration-none text-dark">
                                ID
                                <i class="bi @Model.GetSortIcon("ID") ms-1"></i>
                            </a>
                        </th>
                        <th class="@Model.GetSortHeaderClass("Merchant")">
                            <a asp-page="/User/UserTransactionID" 
                               asp-route-sortBy="Merchant" 
                               asp-route-sortDirection="@Model.MerchantSort" 
                               class="text-decoration-none text-dark">
                                Comercio
                                <i class="bi @Model.GetSortIcon("Merchant") ms-1"></i>
                            </a>
                        </th>
                        <th>Cuenta</th>
                        <th>Banco</th>
                        <th class="@Model.GetSortHeaderClass("Amount")">
                            <a asp-page="/User/UserTransactionID" 
                               asp-route-sortBy="Amount" 
                               asp-route-sortDirection="@Model.AmountSort" 
                               class="text-decoration-none text-dark">
                                Monto Pagado
                                <i class="bi @Model.GetSortIcon("Amount") ms-1"></i>
                            </a>
                        </th>
                        <th>Impuesto de Venta</th>
                        <th class="@Model.GetSortHeaderClass("Date")">
                            <a asp-page="/User/UserTransactionID" 
                               asp-route-sortBy="Date" 
                               asp-route-sortDirection="@Model.DateSort" 
                               class="text-decoration-none text-dark">
                                Fecha
                                <i class="bi @Model.GetSortIcon("Date") ms-1"></i>
                            </a>
                        </th>
                        <th class="@Model.GetSortHeaderClass("Status")">
                            <a asp-page="/User/UserTransactionID" 
                               asp-route-sortBy="Status" 
                               asp-route-sortDirection="@Model.StatusSort" 
                               class="text-decoration-none text-dark">
                                Estado
                                <i class="bi @Model.GetSortIcon("Status") ms-1"></i>
                            </a>
                        </th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var txn in transacciones)
                {
                    var merchant = merchantNames.ContainsKey(txn.MerchantID) ? merchantNames[txn.MerchantID] : "-";
                    var iban = accountIBANs.ContainsKey(txn.BankAccountID) ? accountIBANs[txn.BankAccountID] : "-";
                    var bank = "-";
                    if (accountIBANs.ContainsKey(txn.BankAccountID))
                    {
                        var account = txn.BankAccountID;
                        var allAccounts = Model.AccountIBANs;
                        var allBanks = Model.BankNames;
                        var accountManager = new CoreApp.BankAccountManager();
                        var acc = accountManager.RetrieveBankAccountById(account);
                        if (acc != null && allBanks.ContainsKey(acc.FinancialEntityID))
                        {
                            bank = allBanks[acc.FinancialEntityID];
                        }
                    }
                    
                    // Clase CSS para el estado
                    var statusClass = txn.TransactionStatus switch
                    {
                        "Completed" => "bg-success",
                        "Pending" => "bg-warning text-dark",
                        "Failed" => "bg-danger",
                        "Cancelled" => "bg-secondary",
                        _ => "bg-secondary"
                    };

                    <tr>
                        <td>
                            <strong>#@txn.ID</strong>
                        </td>
                        <td>@merchant</td>
                        <td>
                            @if (iban != "-")
                            {
                                <code class="small">@iban</code>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>@bank</td>
                        <td class="text-end">
                            <strong>₡@txn.NetAmount.ToString("N2")</strong>
                        </td>
                        <td class="text-end">
                            ₡@txn.SalesTaxAmount.ToString("N2")
                        </td>
                        <td>
                            @txn.Timestamp.ToString("dd/MM/yyyy")
                            <br>
                            <small class="text-muted">@txn.Timestamp.ToString("HH:mm")</small>
                        </td>
                        <td>
                            <span class="badge @statusClass">
                                @EstadoEspanol(txn.TransactionStatus)
                            </span>
                        </td>
                        <td>
                            <a asp-page="/User/UserTransactionInvoice" 
                               asp-route-id="@txn.ID" 
                               class="btn btn-sm btn-outline-info">
                                <i class="bi bi-receipt me-1"></i>Ver Transacción
                            </a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <!-- Información de ordenamiento actual -->
        <div class="mt-3">
            <small class="text-muted">
                <i class="bi bi-sort-alpha-down me-1"></i>
                Ordenado por: <strong>@Model.CurrentSort</strong> 
                (@(Model.SortDirection == "asc" ? "Ascendente" : "Descendente"))
            </small>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center">
            <h5><i class="bi bi-info-circle me-2"></i>No tienes transacciones registradas</h5>
            <p class="mb-0">Cuando realices pagos, aparecerán aquí organizados y fáciles de consultar.</p>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Agregar tooltips para explicar el ordenamiento
            const sortHeaders = document.querySelectorAll('th a[asp-route-sortBy]');
            sortHeaders.forEach(header => {
                const sortBy = header.getAttribute('asp-route-sortBy');
                const currentDirection = '@Model.SortDirection';
                const isCurrentSort = sortBy === '@Model.CurrentSort';
                
                let tooltipText = `Ordenar por ${sortBy}`;
                if (isCurrentSort) {
                    tooltipText += ` (${currentDirection === 'asc' ? 'Descendente' : 'Ascendente'})`;
                }
                
                header.setAttribute('title', tooltipText);
            });

            // Inicializar tooltips de Bootstrap si están disponibles
            if (typeof bootstrap !== 'undefined' && bootstrap.Tooltip) {
                const tooltipTriggerList = [].slice.call(document.querySelectorAll('[title]'));
                tooltipTriggerList.map(function (tooltipTriggerEl) {
                    return new bootstrap.Tooltip(tooltipTriggerEl, {
                        placement: 'top',
                        trigger: 'hover'
                    });
                });
            }
        });
    </script>
}
