@page
@model WebApp.Pages.User.ScanPaymentModel
@{
    ViewData["Title"] = "Pagar con QR";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10 col-12">
            
            <!-- Header -->
            <div class="text-center mb-4">
                <h2><i class="bi bi-qr-code-scan me-2"></i>Pagar con QR</h2>
                <p class="text-muted">Escanea o ingresa el código de pago</p>
            </div>

            @if (Model.PaymentExecuted)
            {
                <!-- Pago completado exitosamente -->
                <div class="card shadow-sm border-success">
                    <div class="card-header bg-success text-white text-center">
                        <h5 class="mb-0"><i class="bi bi-check-circle-fill me-2"></i>¡Pago Realizado!</h5>
                    </div>
                    <div class="card-body text-center">
                        <i class="bi bi-check-circle text-success" style="font-size: 4rem;"></i>
                        <h6 class="mt-3">Tu pago ha sido procesado exitosamente</h6>
                        
                        <div class="d-grid gap-2 mt-4">
                            <a href="/User/UserPanel" class="btn btn-primary">
                                <i class="bi bi-house me-1"></i>Volver al Panel
                            </a>
                            <button type="button" class="btn btn-outline-primary" onclick="pagarOtro()">
                                <i class="bi bi-qr-code-scan me-1"></i>Pagar Otro QR
                            </button>
                        </div>
                    </div>
                </div>
            }
            else if (!Model.PaymentRequestFound)
            {
                <!-- Escáner/Input de código QR -->
                <div class="card shadow-sm">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-qr-code-scan me-2"></i>Escanear Código</h5>
                    </div>
                    <div class="card-body">
                        <!-- Botón para activar cámara -->
                        <div class="text-center mb-4">
                            <button type="button" class="btn btn-lg btn-outline-primary" id="btnActivarCamara">
                                <i class="bi bi-camera me-2"></i>Activar Cámara
                            </button>
                            <button type="button" class="btn btn-lg btn-outline-danger d-none" id="btnDetenerCamara">
                                <i class="bi bi-camera-video-off me-2"></i>Detener Cámara
                            </button>
                            <p class="text-muted mt-2 mb-0">O ingresa el código manualmente</p>
                        </div>

                        <!-- Área de escáner con video real -->
                        <div id="scanner-container" class="d-none mb-4">
                            <div class="position-relative">
                                <video id="qr-video" class="w-100 rounded" style="max-height: 400px; object-fit: cover;" autoplay muted playsinline></video>
                                <div id="qr-overlay" class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center">
                                    <div class="border border-success border-3 rounded" style="width: 250px; height: 250px; background: rgba(0, 255, 0, 0.1);"></div>
                                </div>
                                <div class="position-absolute bottom-0 start-0 w-100 p-3 bg-dark bg-opacity-75 text-white text-center">
                                    <small>Enfoca el código QR dentro del recuadro</small>
                                </div>
                            </div>
                            <div id="scan-status" class="text-center mt-2">
                                <small class="text-muted">Iniciando cámara...</small>
                            </div>
                        </div>

                        <!-- Formulario para código manual -->
                        <form method="post" asp-page-handler="Scan" id="scanForm">
                            <div class="mb-3">
                                <label asp-for="PaymentCode" class="form-label">Código de Pago</label>
                                <input asp-for="PaymentCode" type="text" class="form-control" id="paymentCodeInput"
                                       placeholder="Ingresa el código del QR o escanea con la cámara" />
                                <small class="form-text text-muted">
                                    Ejemplo: PAY202501081500001234
                                </small>
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-search me-1"></i>Buscar Pago
                                </button>
                                <a href="/User/UserPanel" class="btn btn-outline-secondary">
                                    <i class="bi bi-arrow-left me-1"></i>Cancelar
                                </a>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Información de ayuda -->
                <div class="card mt-4">
                    <div class="card-body">
                        <h6 class="text-primary">Cómo Pagar:</h6>
                        <ol class="small mb-0">
                            <li>Activa la cámara para escanear o ingresa el código manualmente</li>
                            <li>Revisa los detalles del pago</li>
                            <li>Selecciona tu cuenta bancaria</li>
                            <li>Confirma el pago</li>
                        </ol>
                    </div>
                </div>
            }
            else
            {
                <!-- Mostrar detalles de la solicitud de pago -->
                <div class="card shadow-sm">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0"><i class="bi bi-receipt me-2"></i>Confirmar Pago</h5>
                    </div>
                    <div class="card-body">
                        <!-- Detalles del pago -->
                        <div class="row mb-3">
                            <div class="col-4"><strong>Descripción:</strong></div>
                            <div class="col-8">@Model.PaymentRequest?.Description</div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-4"><strong>Monto:</strong></div>
                            <div class="col-8">
                                <span class="fs-5 text-success">₡@Model.PaymentRequest?.GrossAmount.ToString("N2")</span>
                            </div>
                        </div>
                        @if (Model.MerchantInfo != null)
                        {
                            <div class="row mb-3">
                                <div class="col-4"><strong>Comercio:</strong></div>
                                <div class="col-8">@Model.MerchantInfo.MerchantName</div>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.GetTimeRemaining()) && Model.GetTimeRemaining() != "Expirado")
                        {
                            <div class="row mb-3">
                                <div class="col-4"><strong>Tiempo restante:</strong></div>
                                <div class="col-8">
                                    <span class="text-warning">
                                        <i class="bi bi-clock me-1"></i>@Model.GetTimeRemaining()
                                    </span>
                                </div>
                            </div>
                        }

                        <hr>

                        <form method="post" asp-page-handler="Execute" id="executeForm">
                            <input type="hidden" asp-for="PaymentCode" id="paymentCodeInput" />
                            <input type="hidden" id="grossAmountValue" value="@Model.PaymentRequest?.GrossAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                            <input type="hidden" id="taxAmountValue" value="@Model.PaymentRequest?.SalesTaxAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                            <div class="mb-3">
                                <label asp-for="SelectedBankAccountId" class="form-label">Pagar con</label>
                                <select asp-for="SelectedBankAccountId" class="form-select" id="bankAccountSelect" required>
                                    <option value="">Selecciona una cuenta</option>
                                    @foreach (var account in Model.UserAccountsInfo)
                                    {
                                        <option value="@account.ID" data-financial="@account.FinancialEntityID">@account.DisplayText - Saldo: @account.BalanceText</option>
                                    }
                                </select>
                                @if (!Model.UserAccountsInfo.Any())
                                {
                                    <small class="text-danger">
                                        No tienes cuentas bancarias. 
                                        <a href="/User/UserBankAccount">Agregar cuenta</a>
                                    </small>
                                }
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Promociones Disponibles</label>
                                <div id="promotionContainer" class="border rounded p-3">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="promotionSelection" id="noPromotion" value="" checked data-type="">
                                        <label class="form-check-label" for="noPromotion">Sin promoción</label>
                                    </div>
                                    @if (Model.AvailablePromotions.Any())
                                    {
                                        foreach (var promo in Model.AvailablePromotions)
                                        {
                                            <div class="form-check mb-1">
                                                <input class="form-check-input" type="radio" name="promotionSelection" id="promo@(promo.Id)" value="@promo.Id" data-type="@promo.Type" data-pct="@promo.DiscountPercentage" data-max="@promo.MaxRefund">
                                                <label class="form-check-label" for="promo@(promo.Id)">
                                                    <strong>@promo.Name</strong> - @promo.DiscountPercentage% desc.<br>
                                                    <small class="text-muted">@promo.Description</small>
                                                </label>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="text-muted small mt-2" id="noPromosMsg">Selecciona una cuenta para ver promociones disponibles.</div>
                                    }
                                </div>
                                <input type="hidden" asp-for="SelectedPromotionId" id="SelectedPromotionId" />
                                <input type="hidden" asp-for="SelectedPromotionType" id="SelectedPromotionType" />
                            </div>
                            <div class="mb-3" id="previewCard" style="display:none;">
                                <div class="card border-info">
                                    <div class="card-header py-2 bg-info text-white"><small class="fw-semibold">Previsualización del Pago</small></div>
                                    <div class="card-body py-2">
                                        <div class="row small mb-1">
                                            <div class="col-6 text-muted">Monto bruto:</div>
                                            <div class="col-6 text-end" id="pvGross">-</div>
                                        </div>
                                        <div class="row small mb-1">
                                            <div class="col-6 text-muted">Impuesto:</div>
                                            <div class="col-6 text-end" id="pvTax">-</div>
                                        </div>
                                        <div class="row small mb-1">
                                            <div class="col-6 text-muted">Monto sin impuestos:</div>
                                            <div class="col-6 text-end" id="pvBase">-</div>
                                        </div>
                                        <div class="row small mb-1" id="pvDiscountRow" style="display:none;">
                                            <div class="col-6 text-muted">Descuento (<span id="pvPct">0</span>%):</div>
                                            <div class="col-6 text-end text-success" id="pvDiscount">-</div>
                                        </div>
                                        <hr class="my-1" />
                                        <div class="row">
                                            <div class="col-6 fw-semibold">Total a pagar:</div>
                                            <div class="col-6 text-end fw-bold fs-6" id="pvTotal">-</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="d-grid gap-2">
                                @if (Model.UserAccountsInfo.Any())
                                {
                                    <button type="submit" formaction="?handler=Preview" class="btn btn-primary btn-lg">
                                        <i class="bi bi-clipboard-check me-1"></i>Revisar Pago
                                    </button>
                                }
                                <button type="button" class="btn btn-outline-secondary" onclick="buscarOtro()">
                                    <i class="bi bi-arrow-left me-1"></i>Buscar Otro QR
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Información de seguridad -->
                <div class="alert alert-light mt-4">
                    <h6><i class="bi bi-shield-check me-1"></i>Pago Seguro</h6>
                    <small>Verifica que el comercio y monto sean correctos antes de confirmar</small>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- Cargar QrScanner de forma más compatible -->
    <script src="https://unpkg.com/qr-scanner@1.4.2/qr-scanner.umd.min.js"></script>
    <script>
        // Asegurar que QrScanner esté disponible globalmente
        window.QrScanner = window.QrScanner || QrScanner;
        
        // Verificar disponibilidad antes de cargar el script principal
        if (typeof QrScanner === 'undefined') {
            console.error('QrScanner no se pudo cargar. Intentando cargar versión alternativa...');
            
            // Fallback: cargar desde CDN alternativo
            const script = document.createElement('script');
            script.src = 'https://cdn.jsdelivr.net/npm/qr-scanner@1.4.2/qr-scanner.umd.min.js';
            script.onload = function() {
                window.QrScanner = QrScanner;
                console.log('QrScanner cargado exitosamente desde CDN alternativo');
            };
            script.onerror = function() {
                console.error('Error cargando QrScanner desde CDN alternativo');
            };
            document.head.appendChild(script);
        }
    </script>
    <script src="~/js/ScanPayment.js" charset="UTF-8"></script>

    <script>
        // Configurar el manager con datos del servidor
        document.addEventListener('DOMContentLoaded', function() {
            if (window.ScanPaymentManager) {
                window.ScanPaymentManager.configure({
                    message: @Html.Raw(Json.Serialize(Model.Message ?? ""))
                });
            }
        });
    </script>
}