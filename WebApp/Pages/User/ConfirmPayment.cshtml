@page
@model WebApp.Pages.User.ConfirmPaymentModel
@{
    ViewData["Title"] = "Confirmar Pago";
}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9 col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-eye me-2"></i>Revisar y Confirmar</h5>
                    <span class="badge bg-light text-dark">@Model.PaymentCode</span>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.Message))
                    {
                        <div class="alert alert-warning py-2 mb-3">@Model.Message</div>
                    }
                    
                    <h6 class="text-secondary mb-3">Resumen del Pago</h6>
                    
                    <!-- Información básica -->
                    <dl class="row mb-3">
                        <dt class="col-5 col-md-4">Comercio:</dt>
                        <dd class="col-7 col-md-8">@Model.MerchantInfo?.MerchantName</dd>
                        <dt class="col-5 col-md-4">Cuenta:</dt>
                        <dd class="col-7 col-md-8">@Model.BankAccount?.IBAN (@Model.FinancialEntity?.EntityName)</dd>
                        <dt class="col-5 col-md-4">Descripción:</dt>
                        <dd class="col-7 col-md-8">@Model.PaymentRequest?.Description</dd>
                    </dl>

                    <!-- Cálculos con la nueva lógica comercial -->
                    <div class="card border-success mb-3">
                        <div class="card-header bg-success text-white py-2">
                            <small class="fw-semibold"><i class="bi bi-calculator me-1"></i>Detalle</small>
                        </div>
                        <div class="card-body py-2">
                            <dl class="row mb-0 small">
                                <dt class="col-6">Monto de Venta:</dt>
                                <dd class="col-6 text-end">₡@Model.OriginalNetAmount.ToString("N2")</dd>
                                
                                @if (Model.DiscountPercentage > 0)
                                {
                                    <dt class="col-6">Descuento (@Model.DiscountPercentage.ToString("N1")%):</dt>
                                    <dd class="col-6 text-end text-success">-₡@Model.DiscountAmount.ToString("N2")</dd>
                                    
                                    <dt class="col-6">Subtotal:</dt>
                                    <dd class="col-6 text-end fw-semibold">₡@Model.FinalNetAmount.ToString("N2")</dd>
                                }
                                else
                                {
                                    <dt class="col-6">Subtotal:</dt>
                                    <dd class="col-6 text-end fw-semibold">₡@Model.FinalNetAmount.ToString("N2")</dd>
                                }
                                
                                <dt class="col-6">Impuesto (@Model.TaxRateApplied.ToString("N1")%):</dt>
                                <dd class="col-6 text-end">+₡@Model.RecalculatedSalesTaxAmount.ToString("N2")</dd>
                                
                                <hr class="my-1" />
                                <dt class="col-6 fw-bold text-primary">Total a Pagar:</dt>
                                <dd class="col-6 text-end fw-bold fs-6 text-primary">₡@Model.FinalGrossAmount.ToString("N2")</dd>
                            </dl>
                        </div>
                    </div>

                    <!-- Promoción aplicada -->
                    @if (Model.PromotionId.HasValue && Model.DiscountPercentage > 0)
                    {
                        <div class="alert alert-success py-2 mb-3">
                            <i class="bi bi-tag-fill me-1"></i>
                            <strong>¡Promoción Aplicada!</strong> @Model.DiscountPercentage% de descuento sobre el monto de venta
                            @if (!string.IsNullOrEmpty(Model.PromotionType))
                            {
                                <span class="badge bg-@(Model.PromotionType.Equals("Merchant", StringComparison.OrdinalIgnoreCase) ? "success" : "primary") ms-1">
                                    @(Model.PromotionType.Equals("Merchant", StringComparison.OrdinalIgnoreCase) ? "Promoción del Comercio" : "Promoción del Banco")
                                </span>
                            }
                            <br><small><strong>Ahorras:</strong> ₡@Model.DiscountAmount.ToString("N2")</small>
                        </div>
                    }

                    <hr />
                    <form method="post" asp-page-handler="Confirm">
                        <input type="hidden" asp-for="PaymentCode" />
                        <input type="hidden" asp-for="BankAccountId" />
                        <input type="hidden" asp-for="PromotionId" />
                        <input type="hidden" asp-for="PromotionType" />
                        <div class="d-flex flex-column flex-md-row gap-2">
                            <a asp-page="/User/ScanPayment" asp-route-code="@Model.PaymentCode" class="btn btn-outline-secondary w-100">
                                <i class="bi bi-arrow-left me-1"></i>Volver
                            </a>
                            <button type="submit" class="btn btn-success w-100">
                                <i class="bi bi-check-circle me-1"></i>Confirmar Pago de ₡@Model.FinalGrossAmount.ToString("N2")
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
