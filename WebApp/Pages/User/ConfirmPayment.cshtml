@page
@model WebApp.Pages.User.ConfirmPaymentModel
@{
    ViewData["Title"] = "Confirmar Pago";
}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9 col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-eye me-2"></i>Revisar y Confirmar</h5>
                    <span class="badge bg-light text-dark">@Model.PaymentCode</span>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.Message))
                    {
                        <div class="alert alert-warning py-2 mb-3">@Model.Message</div>
                    }
                    <h6 class="text-secondary mb-3">Resumen del Pago</h6>
                    <dl class="row mb-0">
                        <dt class="col-5 col-md-4">Comercio:</dt>
                        <dd class="col-7 col-md-8">@Model.MerchantInfo?.MerchantName</dd>
                        <dt class="col-5 col-md-4">Cuenta:</dt>
                        <dd class="col-7 col-md-8">@Model.BankAccount?.IBAN (@Model.FinancialEntity?.EntityName)</dd>
                        <dt class="col-5 col-md-4">Descripción:</dt>
                        <dd class="col-7 col-md-8">@Model.PaymentRequest?.Description</dd>
                        <dt class="col-5 col-md-4">Monto Bruto:</dt>
                        <dd class="col-7 col-md-8">?@Model.GrossAmount.ToString("N2")</dd>
                        <dt class="col-5 col-md-4">Impuesto (incluido):</dt>
                        <dd class="col-7 col-md-8">?@Model.SalesTaxAmount.ToString("N2")</dd>
                        <dt class="col-5 col-md-4">Base imponible:</dt>
                        <dd class="col-7 col-md-8">?@Model.OriginalNetAmount.ToString("N2")</dd>
                        <dt class="col-5 col-md-4">Promoción:</dt>
                        <dd class="col-7 col-md-8">
                            @if (Model.PromotionId.HasValue && Model.DiscountPercentage > 0)
                            {
                                <span class="text-success fw-semibold">
                                    @Model.DiscountPercentage% aplicado
                                    @if (!string.IsNullOrEmpty(Model.PromotionType))
                                    {
                                        <span class="badge bg-@(Model.PromotionType.Equals("Merchant", StringComparison.OrdinalIgnoreCase) ? "success" : "primary") ms-1">
                                            @(Model.PromotionType.Equals("Merchant", StringComparison.OrdinalIgnoreCase) ? "Comercio" : "Banco")
                                        </span>
                                    }
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">Ninguna</span>
                            }
                        </dd>
                        <dt class="col-5 col-md-4">Descuento:</dt>
                        <dd class="col-7 col-md-8">
                            @if (Model.DiscountAmount > 0)
                            {
                                <span class="text-success">-?@Model.DiscountAmount.ToString("N2")</span>
                            }
                            else
                            {
                                <span class="text-muted">?0.00</span>
                            }
                        </dd>
                        <dt class="col-5 col-md-4">Subtotal tras desc.:</dt>
                        <dd class="col-7 col-md-8">?@Model.NetAfterDiscount.ToString("N2")</dd>
                        <dt class="col-5 col-md-4">Total a pagar:</dt>
                        <dd class="col-7 col-md-8 fs-5 text-primary">?@Model.FinalPayable.ToString("N2")</dd>
                    </dl>
                    <hr />
                    <form method="post" asp-page-handler="Confirm">
                        <input type="hidden" asp-for="PaymentCode" />
                        <input type="hidden" asp-for="BankAccountId" />
                        <input type="hidden" asp-for="PromotionId" />
                        <input type="hidden" asp-for="PromotionType" />
                        <div class="d-flex flex-column flex-md-row gap-2">
                            <a asp-page="/User/ScanPayment" asp-route-code="@Model.PaymentCode" class="btn btn-outline-secondary w-100"><i class="bi bi-arrow-left me-1"></i>Volver</a>
                            <button type="submit" class="btn btn-success w-100"><i class="bi bi-check-circle me-1"></i>Confirmar Pago</button>
                        </div>
                    </form>
                </div>
            </div>
            <div class="alert alert-light mt-3 small mb-0">
                <i class="bi bi-info-circle me-1"></i>El impuesto no se reduce por promociones. El descuento aplica sobre la base imponible.
            </div>
        </div>
    </div>
</div>
