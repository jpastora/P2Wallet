@page
@model WebApp.Pages.User.PaymentSuccessModel
@{
    ViewData["Title"] = "Pago Exitoso";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-xl-8 col-lg-10 col-md-12">
            <!-- Header de éxito -->
            <div class="text-center mb-4">
                <div class="success-icon mb-3">
                    <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
                </div>
                <h1 class="text-success mb-2">¡Pago Realizado!</h1>
                <p class="text-muted">Tu pago se ha procesado correctamente</p>
            </div>

            @if (!string.IsNullOrEmpty(Model.Message))
            {
                <div class="alert alert-info alert-dismissible fade show" role="alert">
                    <i class="bi bi-info-circle me-2"></i>@Model.Message
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- Detalles de la transacción -->
            @if (Model.Transaction != null)
            {
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-receipt me-2"></i>Detalles de la Transacción
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <strong>ID de Transacción:</strong><br>
                                    <code class="fs-6">#@Model.Transaction.ID</code>
                                </div>
                                <div class="mb-3">
                                    <strong>Descripción:</strong><br>
                                    <span class="text-muted">@Model.Transaction.Description</span>
                                </div>
                                <div class="mb-3">
                                    <strong>Comercio:</strong><br>
                                    <span class="text-primary">@Model.MerchantName</span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <strong>Fecha y Hora:</strong><br>
                                    <span class="text-muted">@Model.Transaction.Timestamp.ToString("dd/MM/yyyy HH:mm:ss")</span>
                                </div>
                                <div class="mb-3">
                                    <strong>Cuenta Utilizada:</strong><br>
                                    <span class="text-muted">@Model.AccountInfo</span>
                                </div>
                                <div class="mb-3">
                                    <strong>Estado:</strong><br>
                                    <span class="badge bg-success">Completado</span>
                                </div>
                            </div>
                        </div>

                        <hr>

                        <!-- Resumen financiero -->
                        <div class="row">
                            <div class="col-md-4 text-center">
                                <div class="border rounded p-3 mb-3">
                                    <i class="bi bi-currency-dollar text-primary fs-4"></i>
                                    <h6 class="mt-2 mb-1">Monto Pagado</h6>
                                    <h4 class="text-primary">₡@Model.Transaction.GrossAmount.ToString("N2")</h4>
                                </div>
                            </div>
                            <div class="col-md-4 text-center">
                                <div class="border rounded p-3 mb-3">
                                    <i class="bi bi-percent text-success fs-4"></i>
                                    <h6 class="mt-2 mb-1">Descuento Aplicado</h6>
                                    <h4 class="text-success">₡@Model.DiscountApplied.ToString("N2")</h4>
                                </div>
                            </div>
                            <div class="col-md-4 text-center">
                                <div class="border rounded p-3 mb-3">
                                    <i class="bi bi-receipt text-info fs-4"></i>
                                    <h6 class="mt-2 mb-1">Monto Final</h6>
                                    <h4 class="text-info">₡@Model.Transaction.NetAmount.ToString("N2")</h4>
                                </div>
                            </div>
                        </div>

                        @if (Model.PromotionApplied != null)
                        {
                            <div class="alert alert-success">
                                <h6 class="alert-heading">
                                    <i class="bi bi-tag-fill me-1"></i>Promoción Aplicada
                                </h6>
                                <strong>@Model.PromotionApplied.Name</strong><br>
                                <small>@Model.PromotionApplied.Description</small>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Acciones -->
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="card-title">¿Qué quieres hacer ahora?</h6>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <a href="/User/UserTransactionInvoice?transactionId=@Model.Transaction?.ID" class="btn btn-outline-primary w-100">
                                <i class="bi bi-download me-1"></i>Descargar Comprobante
                            </a>
                        </div>
                        <div class="col-md-6">
                            <button class="btn btn-outline-secondary w-100" onclick="sharePayment()">
                                <i class="bi bi-share me-1"></i>Compartir
                            </button>
                        </div>
                        <div class="col-md-6">
                            <a href="/User/ScanPayment" class="btn btn-primary w-100">
                                <i class="bi bi-qr-code-scan me-1"></i>Realizar Otro Pago
                            </a>
                        </div>
                        <div class="col-md-6">
                            <a href="/User/UserPanel" class="btn btn-success w-100">
                                <i class="bi bi-house me-1"></i>Volver al Inicio
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <script>
        // Animación de entrada
        document.addEventListener('DOMContentLoaded', function() {
            // Animar icono de éxito
            const successIcon = document.querySelector('.success-icon i');
            if (successIcon) {
                successIcon.style.transform = 'scale(0)';
                successIcon.style.transition = 'transform 0.5s ease-out';
                
                setTimeout(() => {
                    successIcon.style.transform = 'scale(1)';
                }, 200);
            }
        });

        // Función para compartir pago
        function sharePayment() {
            const shareData = {
                title: 'Pago realizado con Yavi',
                text: 'Acabo de realizar un pago con Yavi!',
                url: window.location.href
            };

            if (navigator.share) {
                navigator.share(shareData);
            } else {
                // Fallback para browsers que no soportan Web Share API
                const shareText = shareData.text + ' ' + shareData.url;
                
                if (navigator.clipboard) {
                    navigator.clipboard.writeText(shareText).then(() => {
                        Swal.fire({
                            icon: 'success',
                            title: '¡Copiado!',
                            text: 'Información del pago copiada al portapapeles',
                            timer: 2000,
                            showConfirmButton: false
                        });
                    });
                } else {
                    // Fallback más básico
                    prompt('Copia este texto para compartir:', shareText);
                }
            }
        }
    </script>
    
    <style>
        .success-icon {
            animation: bounce 1s ease-out;
        }

        /* Keyframe para animación bounce */
        @@keyframes bounce {
            0%, 20%, 53%, 80%, 100% {
                animation-timing-function: cubic-bezier(0.215, 0.61, 0.355, 1);
                transform: translate3d(0, 0, 0);
            }
            40%, 43% {
                animation-timing-function: cubic-bezier(0.755, 0.05, 0.855, 0.06);
                transform: translate3d(0, -30px, 0);
            }
            70% {
                animation-timing-function: cubic-bezier(0.755, 0.05, 0.855, 0.06);
                transform: translate3d(0, -15px, 0);
            }
            90% {
                transform: translate3d(0, -4px, 0);
            }
        }
    </style>
}