@page
@model WebApp.Pages.User.PaymentSuccessModel
@{
    ViewData["Title"] = "Pago Exitoso";
    var txn = Model.Transaction;
    var user = Model.CurrentUser;
    var merchant = Model.MerchantName;
    var account = Model.AccountInfo;
    var discountApplied = Model.DiscountApplied;
    var promotion = Model.PromotionApplied;
    string EstadoEspanol(string status) => status switch
    {
        "Completed" => "Completada",
        "Pending" => "Pendiente",
        "Failed" => "Fallida",
        "Cancelled" => "Cancelada",
        _ => status
    };
}

<link rel="stylesheet" href="~/css/UserTransactionInvoice.css" />

<div class="container py-4 mb-5">
    <!-- Header de éxito -->
    <div class="text-center mb-4">
        <div class="success-icon mb-3">
            <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem; animation: bounce 1s ease-out;"></i>
        </div>
        <h1 class="text-success mb-2">¡Pago Realizado!</h1>
        <p class="text-muted">Tu pago se ha procesado correctamente</p>
    </div>

    <!-- Factura con estilo de UserTransactionInvoice -->
    <div class="factura-box">
        <div class="factura-header">
            Comprobante de Pago
        </div>
        @if (txn != null)
        {
            <div class="factura-info-row">
                <div class="factura-info-list">
                    <div><span>ID Transacción:</span> #@txn.ID</div>
                    <div><span>Usuario:</span> @user?.FirstName @user?.LastName</div>
                    <div><span>Comercio:</span> @merchant</div>
                    <div><span>Cuenta:</span> @account</div>
                    <div><span>Estado:</span> @EstadoEspanol(txn.TransactionStatus)</div>
                </div>
                <div class="factura-fecha">
                    <span>Fecha:</span> @txn.Timestamp.ToString("dd/MM/yyyy HH:mm")
                </div>
            </div>
            
            <div class="factura-table-responsive">
                <table class="factura-table">
                    <tbody>
                        <!-- CORREGIDO: Mostrar lógica comercial correcta -->
                        @{
                            var originalNetAmountCalculated = discountApplied > 0 ? txn.NetAmount + discountApplied : txn.NetAmount;
                        }
                        
                        @if (discountApplied > 0)
                        {
                            <tr>
                                <td><strong>Monto de Venta Original</strong></td>
                                <td class="factura-monto">₡@originalNetAmountCalculated.ToString("N2")</td>
                            </tr>
                            <tr>
                                <td>Descuento Aplicado</td>
                                <td class="factura-monto factura-descuento">-₡@discountApplied.ToString("N2")</td>
                            </tr>
                            <tr>
                                <td><strong>Subtotal (después descuento)</strong></td>
                                <td class="factura-monto">₡@txn.NetAmount.ToString("N2")</td>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <td><strong>Monto de Venta</strong></td>
                                <td class="factura-monto">₡@txn.NetAmount.ToString("N2")</td>
                            </tr>
                        }
                        
                        @if (promotion != null)
                        {
                            <tr>
                                <td>Promoción Aplicada</td>
                                <td>@promotion.Name (@promotion.TypeText)</td>
                            </tr>
                            @if (promotion.DiscountPercentage > 0)
                            {
                                <tr>
                                    <td>Porcentaje de descuento</td>
                                    <td>@promotion.DiscountPercentage.ToString("N2")%</td>
                                </tr>
                            }
                        }
                        
                        <tr>
                            <td>Impuesto Aplicado (@txn.TaxRateApplied.ToString("N1")%)</td>
                            <td class="factura-monto factura-impuesto">₡@txn.SalesTaxAmount.ToString("N2")</td>
                        </tr>
                        
                        <tr class="factura-total-row">
                            <td><strong>Total Pagado</strong></td>
                            <td class="factura-monto"><strong>₡@txn.GrossAmount.ToString("N2")</strong></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            
            <!-- Botones de acción con estilo original (d-grid gap-2) -->
            <div class="d-grid gap-2 mt-4">
                <a href="/User/ScanPayment" class="btn btn-primary">
                    <i class="bi bi-qr-code-scan me-1"></i>Realizar Otro Pago
                </a>
                <a href="/User/UserPanel" class="btn btn-outline-secondary">
                    <i class="bi bi-house me-1"></i>Volver al Panel
                </a>
            </div>
        }
        else
        {
            <div class="alert alert-danger">No se encontró información de la transacción.</div>
        }
    </div>

    <!-- Mensaje de seguridad -->
    <div class="alert alert-light mt-4 border-0">
        <div class="row align-items-center">
            <div class="col-auto">
                <i class="bi bi-shield-check text-success fs-3"></i>
            </div>
            <div class="col">
                <h6 class="mb-1 text-success fw-bold">Pago Seguro y Verificado</h6>
                <small class="text-muted">
                    Tu transacción #@txn?.ID ha sido procesada de forma segura. 
                    Guarda este comprobante para tus registros contables.
                </small>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/PaymentSuccess.js"></script>
    
    <script>
        // Configurar el manager con datos del servidor
        document.addEventListener('DOMContentLoaded', function() {
            if (window.PaymentSuccessManager) {
                window.PaymentSuccessManager.configure({
                    message: @Html.Raw(Json.Serialize(Model.Message ?? "")),
                    transactionId: @(Model.Transaction?.ID ?? 0)
                });
            }
        });
    </script>
}