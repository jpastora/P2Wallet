@page
@model WebApp.Pages.Administrator.EditMerchantModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Editar Comercio";
}

<h1 class="mb-4">Editar Comercio</h1>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        @Model.Message
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0">Información del Comercio</h6>
            </div>
            <div class="card-body">
                <form method="post" id="editMerchantForm">
                    <input type="hidden" asp-for="MerchantToEdit.ID" />
                    <input type="hidden" asp-for="MerchantToEdit.LogoImage" id="hiddenLogoImage" />
                    
                    <!-- Logo Section -->
                    <div class="row">
                        <div class="col-12 mb-3">
                            <label class="form-label">Logo del Comercio</label>
                            <div class="d-flex align-items-center gap-3">
                                <div class="text-center">
                                    <img id="logoPreview" src="@(Model.MerchantToEdit.LogoImage ?? "https://picsum.photos/seed/merchant/120")" 
                                         alt="Logo del comercio" class="rounded" style="width:80px;height:80px;object-fit:cover;">
                                </div>
                                <div class="flex-grow-1">
                                    <input type="file" class="form-control mb-2" id="logoFile" accept="image/*">
                                    <button type="button" class="btn btn-outline-primary btn-sm" id="btnUploadLogo">
                                        <i class="bi bi-cloud-upload"></i> Subir Nuevo Logo
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <hr>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="MerchantToEdit.MerchantName" class="form-label">Nombre del Comercio</label>
                            <input asp-for="MerchantToEdit.MerchantName" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="MerchantToEdit.TaxID" class="form-label">Tax ID</label>
                            <input asp-for="MerchantToEdit.TaxID" class="form-control" required />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="MerchantToEdit.Email" class="form-label">Email</label>
                            <input asp-for="MerchantToEdit.Email" type="email" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="MerchantToEdit.ContactPhone" class="form-label">Teléfono</label>
                            <input asp-for="MerchantToEdit.ContactPhone" class="form-control" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="MerchantToEdit.CommissionPercentage" class="form-label">Porcentaje de Comisión</label>
                            <input asp-for="MerchantToEdit.CommissionPercentage" type="number" step="0.01" min="0" max="100" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="MerchantToEdit.ValidationStatus" class="form-label">Estado</label>
                            <select asp-for="MerchantToEdit.ValidationStatus" class="form-select">
                                <option value="Active">Activo</option>
                                <option value="Inactive">Inactivo</option>
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="MerchantToEdit.Latitude" class="form-label">Latitud</label>
                            <input asp-for="MerchantToEdit.Latitude" type="number" step="any" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="MerchantToEdit.Longitude" class="form-label">Longitud</label>
                            <input asp-for="MerchantToEdit.Longitude" type="number" step="any" class="form-control" />
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a href="/Administrator/AdministratorPanelMerchants" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Volver
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save"></i> Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0">Información Adicional</h6>
            </div>
            <div class="card-body">
                <p><strong>ID:</strong> @Model.MerchantToEdit.ID</p>
                
                @if (!string.IsNullOrEmpty(Model.MerchantToEdit.LogoImage))
                {
                    <div class="text-center">
                        <img src="@Model.MerchantToEdit.LogoImage" class="img-fluid rounded" alt="Logo del comercio" style="max-height: 200px;">
                    </div>
                }
                else
                {
                    <div class="text-center text-muted">
                        <i class="bi bi-shop" style="font-size: 4rem;"></i>
                        <p>Sin logo</p>
                    </div>
                }

                @if (Model.MerchantToEdit.Latitude != 0 || Model.MerchantToEdit.Longitude != 0)
                {
                    <hr>
                    <p><strong>Ubicación:</strong></p>
                    <p>Lat: @Model.MerchantToEdit.Latitude.ToString("0.000000")</p>
                    <p>Lng: @Model.MerchantToEdit.Longitude.ToString("0.000000")</p>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Funcionalidad de subida de logo
            document.getElementById('btnUploadLogo').addEventListener('click', function () {
                var fileInput = document.getElementById('logoFile');
                var file = fileInput.files[0];
                if (!file) {
                    Swal.fire('Error', 'Selecciona una imagen primero.', 'error');
                    return;
                }
                
                var formData = new FormData();
                formData.append('photo', file);
                
                // Mostrar loading
                Swal.fire({
                    title: 'Subiendo imagen...',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });
                
                fetch('https://p2wallet-api-eyefddgeeda9c2fk.eastus-01.azurewebsites.net/api/cloudinary/Save', {
                    method: 'POST',
                    body: formData
                })
                .then(response => response.json())
                .then(data => {
                    var url = data.secure_url || data.url;
                    if (url) {
                        document.getElementById('hiddenLogoImage').value = url;
                        document.getElementById('logoPreview').src = url;
                        Swal.fire('¡Éxito!', 'Logo subido correctamente.', 'success');
                    } else {
                        Swal.fire('Error', 'No se pudo obtener la URL del logo.', 'error');
                    }
                })
                .catch(() => {
                    Swal.fire('Error', 'Error al subir la imagen.', 'error');
                });
            });
        });
    </script>
}