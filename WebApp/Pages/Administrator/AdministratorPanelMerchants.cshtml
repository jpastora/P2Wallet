@page
@model WebApp.Pages.Administrator.AdministratorPanelMerchantsModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Administración de Comercios";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h1 class="mb-4"><i class="bi bi-shop me-2"></i>Administración de Comercios</h1>

            @if (!string.IsNullOrEmpty(TempData["SuccessMessage"]?.ToString()))
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (!string.IsNullOrEmpty(TempData["ErrorMessage"]?.ToString()))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <!-- Búsqueda simple -->
            <div class="card mb-4 shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h7 class="mb-0"><i class="bi bi-search me-2"></i>Buscar Comercios</h7>
                </div>
                <div class="card-body">
                    <form method="get" class="row g-3">
                        <div class="col-lg-8 col-md-7 col-12">
                            <input type="text" class="form-control" name="searchTerm" 
                                   value="@Model.SearchTerm" placeholder="Buscar por nombre o email...">
                        </div>
                        <div class="col-lg-4 col-md-5 col-12">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="bi bi-search me-1"></i>Buscar
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Lista de comercios -->
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <h7 class="mb-0">
                        <i class="bi bi-shop me-2"></i>
                        Lista de Comercios (@Model.TotalMerchants total)
                    </h7>
                </div>
                <div class="card-body p-0">
                    @if (Model.AllMerchants.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Nombre</th>
                                        <th class="d-none d-lg-table-cell">Email</th>
                                        <th class="d-none d-md-table-cell">Teléfono</th>
                                        <th class="d-none d-xl-table-cell">Tax ID</th>
                                        <th class="d-none d-lg-table-cell">Comisión %</th>
                                        <th>Estado</th>
                                        <th class="text-center">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var merchant in Model.AllMerchants)
                                    {
                                        var isActive = merchant.ValidationStatus == "Active";

                                        <tr>
                                            <td>
                                                <strong>@merchant.MerchantName</strong>
                                                <div class="d-lg-none small text-muted">
                                                    @(merchant.Email.Length > 25 ? merchant.Email.Substring(0, 25) + "..." : merchant.Email)
                                                </div>
                                            </td>
                                            <td class="d-none d-lg-table-cell">@merchant.Email</td>
                                            <td class="d-none d-md-table-cell">@merchant.ContactPhone</td>
                                            <td class="d-none d-xl-table-cell">@merchant.TaxID</td>
                                            <td class="d-none d-lg-table-cell">@merchant.CommissionPercentage.ToString("0.0")%</td>
                                            <td>
                                                <span class="badge @(isActive ? "bg-success" : "bg-secondary")">
                                                    @AdministratorPanelMerchantsModel.EstadoEspanol(merchant.ValidationStatus)
                                                </span>
                                            </td>
                                            <td>
                                                <div class="d-flex flex-column flex-lg-row gap-1 justify-content-center">
                                                    <form method="post" asp-page-handler="ToggleStatus" class="d-inline">
                                                        <input type="hidden" name="merchantId" value="@merchant.ID" />
                                                        <button type="submit" class="btn btn-sm @(isActive ? "btn-outline-secondary" : "btn-outline-success") w-100 w-lg-auto">
                                                            <i class="bi bi-@(isActive ? "lock" : "unlock") me-1"></i>
                                                            <span class="d-none d-sm-inline">@(isActive ? "Desactivar" : "Activar")</span>
                                                        </button>
                                                    </form>
                                                    <a href="/Administrator/EditMerchant?merchantId=@merchant.ID" class="btn btn-sm btn-outline-primary w-100 w-lg-auto">
                                                        <i class="bi bi-pencil me-1"></i>
                                                        <span class="d-none d-sm-inline">Editar</span>
                                                    </a>
                                                    <button type="button" class="btn btn-sm btn-outline-info w-100 w-lg-auto" data-bs-toggle="modal" data-bs-target="#assignMerchantModal@(merchant.ID)">
                                                        <i class="bi bi-person-plus me-1"></i>
                                                        <span class="d-none d-sm-inline">Asignar</span>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-shop text-muted" style="font-size: 3rem;"></i>
                            <h5 class="text-muted mt-3">No se encontraron comercios</h5>
                            <p class="text-muted">Intenta ajustar los criterios de búsqueda</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Modales para asignar usuarios -->
            @foreach (var merchant in Model.AllMerchants)
            {
                <div class="modal fade" id="assignMerchantModal@(merchant.ID)" tabindex="-1" aria-labelledby="assignMerchantModalLabel@(merchant.ID)" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header bg-primary text-white">
                                <h5 class="modal-title" id="assignMerchantModalLabel@(merchant.ID)">
                                    <i class="bi bi-person-plus me-2"></i>Asignar Usuario al Comercio
                                </h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <form method="post" asp-page-handler="AssignMerchant">
                                <div class="modal-body">
                                    <input type="hidden" name="merchantId" value="@merchant.ID" />
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Comercio:</label>
                                        <p class="text-muted">@merchant.MerchantName</p>
                                    </div>
                                    <div class="mb-3">
                                        <label for="userId@(merchant.ID)" class="form-label fw-bold">Seleccionar Usuario</label>
                                        <select class="form-select" name="userId" id="userId@(merchant.ID)" required>
                                            <option value="">-- Seleccione un usuario --</option>
                                            @foreach (var user in Model.AllUsers)
                                            {
                                                <option value="@user.ID">@user.FirstName @user.LastName (@user.Email)</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="alert alert-info">
                                        <small>
                                            <i class="bi bi-info-circle me-1"></i>
                                            Al asignar este comercio al usuario, el usuario podrá acceder al panel de administración del comercio.
                                        </small>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                        <i class="bi bi-x-lg me-1"></i>Cancelar
                                    </button>
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bi bi-check-lg me-1"></i>Asignar Comercio
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }

            <!-- Paginación simple -->
            @if (Model.TotalPages > 1)
            {
                <nav class="mt-4">
                    <ul class="pagination justify-content-center flex-wrap">
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" href="?searchTerm=@Model.SearchTerm&currentPage=@Model.PreviousPage">
                                <i class="bi bi-chevron-left"></i>
                                <span class="d-none d-sm-inline ms-1">Anterior</span>
                            </a>
                        </li>
                        
                        <li class="page-item active">
                            <span class="page-link">
                                <span class="d-none d-sm-inline">Página </span>@Model.CurrentPage<span class="d-none d-sm-inline"> de @Model.TotalPages</span>
                            </span>
                        </li>
                        
                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link" href="?searchTerm=@Model.SearchTerm&currentPage=@Model.NextPage">
                                <span class="d-none d-sm-inline me-1">Siguiente</span>
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>