@page
@model WebApp.Pages.Administrator.EditMerchantPromotionModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Editar Promoción de Comercio";
}

<h1 class="mb-4">Editar Promoción de Comercio</h1>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        @Model.Message
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0">Información de la Promoción</h6>
            </div>
            <div class="card-body">
                <form method="post">
                    <input type="hidden" asp-for="PromotionToEdit.ID" />
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="PromotionToEdit.MerchantPromotionName" class="form-label">Nombre de la Promoción</label>
                            <input asp-for="PromotionToEdit.MerchantPromotionName" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="PromotionToEdit.PromotionType" class="form-label">Tipo de Promoción</label>
                            <input asp-for="PromotionToEdit.PromotionType" class="form-control" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="PromotionToEdit.DiscountPercentage" class="form-label">Porcentaje de Descuento</label>
                            <input asp-for="PromotionToEdit.DiscountPercentage" type="number" step="0.01" min="0" max="100" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="PromotionToEdit.MaxRefund" class="form-label">Reembolso Máximo</label>
                            <input asp-for="PromotionToEdit.MaxRefund" type="number" step="0.01" min="0" class="form-control" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="PromotionToEdit.StartDate" class="form-label">Fecha de Inicio</label>
                            <input asp-for="PromotionToEdit.StartDate" type="datetime-local" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="PromotionToEdit.EndDate" class="form-label">Fecha de Fin</label>
                            <input asp-for="PromotionToEdit.EndDate" type="datetime-local" class="form-control" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="PromotionToEdit.AvailableQuantity" class="form-label">Cantidad Disponible</label>
                            <input asp-for="PromotionToEdit.AvailableQuantity" type="number" min="0" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="PromotionToEdit.ValidationStatus" class="form-label">Estado</label>
                            <select asp-for="PromotionToEdit.ValidationStatus" class="form-select">
                                <option value="Active">Activo</option>
                                <option value="Inactive">Inactivo</option>
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12 mb-3">
                            <label asp-for="PromotionToEdit.MerchantPromotionDescription" class="form-label">Descripción</label>
                            <textarea asp-for="PromotionToEdit.MerchantPromotionDescription" class="form-control" rows="3"></textarea>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12 mb-3">
                            <label asp-for="PromotionToEdit.MerchantPromotionTerms" class="form-label">Términos y Condiciones</label>
                            <textarea asp-for="PromotionToEdit.MerchantPromotionTerms" class="form-control" rows="4"></textarea>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12 mb-3">
                            <label asp-for="PromotionToEdit.MerchantPromotionImage" class="form-label">URL de la Imagen</label>
                            <input asp-for="PromotionToEdit.MerchantPromotionImage" type="url" class="form-control" />
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a href="/Administrator/AdministratorPanelPromotions" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Volver
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save"></i> Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0">Información Adicional</h6>
            </div>
            <div class="card-body">
                <p><strong>ID:</strong> @Model.PromotionToEdit.ID</p>
                <p><strong>Comercio ID:</strong> @Model.PromotionToEdit.MerchantID</p>
                @if (Model.PromotionToEdit.CreatedAt != DateTime.MinValue)
                {
                    <p><strong>Creada:</strong> @Model.PromotionToEdit.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                }
                
                @if (!string.IsNullOrEmpty(Model.PromotionToEdit.MerchantPromotionImage))
                {
                    <div class="text-center">
                        <img src="@Model.PromotionToEdit.MerchantPromotionImage" class="img-fluid rounded" alt="Imagen de la promoción" style="max-height: 200px;">
                    </div>
                }
                else
                {
                    <div class="text-center text-muted">
                        <i class="bi bi-image" style="font-size: 4rem;"></i>
                        <p>Sin imagen</p>
                    </div>
                }

                @if (Model.PromotionToEdit.StartDate <= DateTime.Now && Model.PromotionToEdit.EndDate >= DateTime.Now)
                {
                    <div class="alert alert-success mt-3">
                        <i class="bi bi-check-circle"></i> Promoción vigente
                    </div>
                }
                else if (Model.PromotionToEdit.EndDate < DateTime.Now)
                {
                    <div class="alert alert-danger mt-3">
                        <i class="bi bi-x-circle"></i> Promoción expirada
                    </div>
                }
                else
                {
                    <div class="alert alert-warning mt-3">
                        <i class="bi bi-clock"></i> Promoción no iniciada
                    </div>
                }
            </div>
        </div>
    </div>
</div>