@page
@model WebApp.Pages.Administrator.AdministratorPanelUsersModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Administración de Usuarios";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h1 class="mb-4"><i class="bi bi-people me-2"></i>Administración de Usuarios</h1>

            @if (!string.IsNullOrEmpty(TempData["SuccessMessage"]?.ToString()))
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (!string.IsNullOrEmpty(TempData["ErrorMessage"]?.ToString()))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <!-- Búsqueda simple -->
            <div class="card mb-4 shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h7 class="mb-0"><i class="bi bi-search me-2"></i>Buscar Usuarios</h7>
                </div>
                <div class="card-body">
                    <form method="get" class="row g-3">
                        <div class="col-lg-8 col-md-7 col-12">
                            <input type="text" class="form-control" name="searchTerm" 
                                   value="@Model.SearchTerm" placeholder="Buscar por nombre o email...">
                        </div>
                        <div class="col-lg-4 col-md-5 col-12">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="bi bi-search me-1"></i>Buscar
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Lista de usuarios -->
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <h7 class="mb-0">
                        <i class="bi bi-people me-2"></i>
                        Lista de Usuarios (@Model.TotalUsers total)
                    </h7>
                </div>
                <div class="card-body p-0">
                    @if (Model.AllUsers.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Nombre</th>
                                        <th>Email</th>
                                        <th class="d-none d-md-table-cell">Teléfono</th>
                                        <th>Estado</th>
                                        <th class="text-center">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var user in Model.AllUsers)
                                    {
                                        var currentUserEmail = User.Identity?.Name;
                                        var isCurrentUser = user.Email == currentUserEmail;
                                        var isActive = user.ValidationStatus == "Active";

                                        <tr class="@(isCurrentUser ? "table-warning" : "")">
                                            <td>
                                                <strong>@user.FirstName @user.LastName</strong>
                                                @if (isCurrentUser)
                                                {
                                                    <br><small class="text-warning">Eres tú</small>
                                                }
                                            </td>
                                            <td>
                                                <span class="d-none d-lg-inline">@user.Email</span>
                                                <span class="d-lg-none">@(user.Email.Length > 20 ? user.Email.Substring(0, 20) + "..." : user.Email)</span>
                                            </td>
                                            <td class="d-none d-md-table-cell">@user.MobilePhone</td>
                                            <td>
                                                <span class="badge @(isActive ? "bg-success" : "bg-secondary")">
                                                    @AdministratorPanelUsersModel.EstadoEspanol(user.ValidationStatus)
                                                </span>
                                            </td>
                                            <td>
                                                @if (!isCurrentUser)
                                                {
                                                    <div class="d-flex flex-column flex-sm-row gap-1 justify-content-center">
                                                        <form method="post" asp-page-handler="ToggleStatus" class="d-inline">
                                                            <input type="hidden" name="userId" value="@user.ID" />
                                                            <button type="submit" class="btn btn-sm @(isActive ? "btn-outline-secondary" : "btn-outline-success") w-100 w-sm-auto">
                                                                <i class="bi bi-@(isActive ? "lock" : "unlock") me-1"></i>
                                                                <span class="d-none d-sm-inline">@(isActive ? "Desactivar" : "Activar")</span>
                                                            </button>
                                                        </form>
                                                        <a href="/Administrator/EditUser?userId=@user.ID" class="btn btn-sm btn-outline-primary w-100 w-sm-auto">
                                                            <i class="bi bi-pencil me-1"></i>
                                                            <span class="d-none d-sm-inline">Editar</span>
                                                        </a>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="text-center">
                                                        <span class="text-muted small">No disponible</span>
                                                    </div>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-people text-muted" style="font-size: 3rem;"></i>
                            <h5 class="text-muted mt-3">No se encontraron usuarios</h5>
                            <p class="text-muted">Intenta ajustar los criterios de búsqueda</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Paginación simple -->
            @if (Model.TotalPages > 1)
            {
                <nav class="mt-4">
                    <ul class="pagination justify-content-center flex-wrap">
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" href="?searchTerm=@Model.SearchTerm&currentPage=@Model.PreviousPage">
                                <i class="bi bi-chevron-left"></i>
                                <span class="d-none d-sm-inline ms-1">Anterior</span>
                            </a>
                        </li>
                        
                        <li class="page-item active">
                            <span class="page-link">
                                <span class="d-none d-sm-inline">Página </span>@Model.CurrentPage<span class="d-none d-sm-inline"> de @Model.TotalPages</span>
                            </span>
                        </li>
                        
                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link" href="?searchTerm=@Model.SearchTerm&currentPage=@Model.NextPage">
                                <span class="d-none d-sm-inline me-1">Siguiente</span>
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>