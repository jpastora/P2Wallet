@page
@model WebApp.Pages.Administrator.EditTransactionModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Editar Transacción";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h1 class="mb-4"><i class="bi bi-card-checklist me-2"></i>Editar Transacción</h1>

            @if (!string.IsNullOrEmpty(Model.Message))
            {
                <div class="alert alert-warning alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>@Model.Message
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
        </div>
    </div>

    <div class="row">
        <div class="col-xl-8 col-lg-7 col-md-12 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h7 class="mb-0"><i class="bi bi-receipt me-2"></i>Información de la Transacción</h7>
                </div>
                <div class="card-body">
                    <form method="post" id="editTransactionForm">
                        <input type="hidden" asp-for="TransactionToEdit.ID" />
                        <input type="hidden" asp-for="TransactionToEdit.UserID" />
                        <input type="hidden" asp-for="TransactionToEdit.MerchantID" />
                        <input type="hidden" asp-for="TransactionToEdit.BankAccountID" />
                        
                        <!-- Información de referencia (solo lectura) -->
                        <div class="row">
                            <div class="col-xl-6 col-lg-12 col-md-6 mb-3">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-person me-1"></i>Usuario
                                </label>
                                <input type="text" class="form-control bg-light" value="@Model.GetUserName(Model.TransactionToEdit.UserID)" readonly />
                            </div>
                            <div class="col-xl-6 col-lg-12 col-md-6 mb-3">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-shop me-1"></i>Comercio
                                </label>
                                <input type="text" class="form-control bg-light" value="@Model.GetMerchantName(Model.TransactionToEdit.MerchantID)" readonly />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-xl-6 col-lg-12 col-md-6 mb-3">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-credit-card me-1"></i>Cuenta Bancaria
                                </label>
                                <input type="text" class="form-control bg-light" value="@Model.GetBankAccountInfo(Model.TransactionToEdit.BankAccountID)" readonly />
                            </div>
                            <div class="col-xl-6 col-lg-12 col-md-6 mb-3">
                                <label asp-for="TransactionToEdit.TransactionStatus" class="form-label fw-bold">
                                    <i class="bi bi-check-circle me-1"></i>Estado de la Transacción
                                </label>
                                <select asp-for="TransactionToEdit.TransactionStatus" class="form-select">
                                    <option value="Pending">Pendiente</option>
                                    <option value="PendingUserApproval">Pendiente de Aprobación</option>
                                    <option value="Processing">Procesando</option>
                                    <option value="Completed">Completada</option>
                                    <option value="Failed">Fallida</option>
                                    <option value="Cancelled">Cancelada</option>
                                    <option value="Rejected">Rechazada</option>
                                </select>
                            </div>
                        </div>

                        <hr class="my-4">
                        <h6 class="text-primary"><i class="bi bi-currency-dollar me-2"></i>Información Monetaria</h6>

                        <!-- Campos editables de montos -->
                        <div class="row">
                            <div class="col-xl-6 col-lg-12 col-md-6 mb-3">
                                <label asp-for="TransactionToEdit.GrossAmount" class="form-label fw-bold">
                                    <i class="bi bi-cash-stack me-1"></i>Monto Bruto
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">₡</span>
                                    <input asp-for="TransactionToEdit.GrossAmount" type="number" step="0.01" min="0" class="form-control" />
                                </div>
                            </div>
                            <div class="col-xl-6 col-lg-12 col-md-6 mb-3">
                                <label asp-for="TransactionToEdit.NetAmount" class="form-label fw-bold">
                                    <i class="bi bi-cash me-1"></i>Monto Neto
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">₡</span>
                                    <input asp-for="TransactionToEdit.NetAmount" type="number" step="0.01" min="0" class="form-control" />
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-xl-6 col-lg-12 col-md-6 mb-3">
                                <label asp-for="TransactionToEdit.CommissionApplied" class="form-label fw-bold">
                                    <i class="bi bi-percent me-1"></i>Comisión Aplicada
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">₡</span>
                                    <input asp-for="TransactionToEdit.CommissionApplied" type="number" step="0.01" min="0" class="form-control" />
                                </div>
                            </div>
                            <div class="col-xl-6 col-lg-12 col-md-6 mb-3">
                                <label asp-for="TransactionToEdit.SalesTaxAmount" class="form-label fw-bold">
                                    <i class="bi bi-receipt-cutoff me-1"></i>Monto de Impuesto
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">₡</span>
                                    <input asp-for="TransactionToEdit.SalesTaxAmount" type="number" step="0.01" min="0" class="form-control" />
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-xl-6 col-lg-12 col-md-6 mb-3">
                                <label asp-for="TransactionToEdit.TaxRateApplied" class="form-label fw-bold">
                                    <i class="bi bi-calculator me-1"></i>Tasa de Impuesto Aplicada
                                </label>
                                <div class="input-group">
                                    <input asp-for="TransactionToEdit.TaxRateApplied" type="number" step="0.01" min="0" max="100" class="form-control" />
                                    <span class="input-group-text">%</span>
                                </div>
                            </div>
                            <div class="col-xl-6 col-lg-12 col-md-6 mb-3">
                                <label asp-for="TransactionToEdit.Timestamp" class="form-label fw-bold">
                                    <i class="bi bi-calendar-event me-1"></i>Fecha y Hora
                                </label>
                                <input asp-for="TransactionToEdit.Timestamp" type="datetime-local" class="form-control" />
                            </div>
                        </div>

                        <hr class="my-4">
                        <h6 class="text-primary"><i class="bi bi-tag me-2"></i>Promociones (Opcional)</h6>

                        <!-- Promociones (opcional) -->
                        <div class="row">
                            <div class="col-xl-6 col-lg-12 col-md-6 mb-3">
                                <label asp-for="TransactionToEdit.MerchantPromotionID" class="form-label fw-bold">
                                    <i class="bi bi-shop me-1"></i>Promoción de Comercio
                                </label>
                                <input asp-for="TransactionToEdit.MerchantPromotionID" type="number" min="1" class="form-control" placeholder="ID de promoción" />
                                <small class="form-text text-muted">Dejar vacío si no aplica</small>
                            </div>
                            <div class="col-xl-6 col-lg-12 col-md-6 mb-3">
                                <label asp-for="TransactionToEdit.FinancialPromotionID" class="form-label fw-bold">
                                    <i class="bi bi-bank me-1"></i>Promoción Financiera
                                </label>
                                <input asp-for="TransactionToEdit.FinancialPromotionID" type="number" min="1" class="form-control" placeholder="ID de promoción" />
                                <small class="form-text text-muted">Dejar vacío si no aplica</small>
                            </div>
                        </div>

                        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center mt-4 pt-3 border-top gap-2">
                            <a href="/Administrator/AdministratorPanelTransactions" class="btn btn-secondary w-100 w-sm-auto">
                                <i class="bi bi-arrow-left me-1"></i>Volver
                            </a>
                            <button type="submit" class="btn btn-primary w-100 w-sm-auto">
                                <i class="bi bi-check-lg me-1"></i>Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        
        <div class="col-xl-4 col-lg-5 col-md-12">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <h7 class="mb-0"><i class="bi bi-info-circle me-2"></i>Información Adicional</h7>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <strong><i class="bi bi-hash me-1"></i>ID de Transacción:</strong> 
                        <span class="badge bg-secondary">#@Model.TransactionToEdit.ID</span>
                    </div>
                    <div class="mb-3">
                        <strong><i class="bi bi-person me-1"></i>Usuario ID:</strong><br>
                        <span class="text-muted">@Model.TransactionToEdit.UserID</span>
                    </div>
                    <div class="mb-3">
                        <strong><i class="bi bi-shop me-1"></i>Comercio ID:</strong><br>
                        <span class="text-muted">@Model.TransactionToEdit.MerchantID</span>
                    </div>
                    <div class="mb-3">
                        <strong><i class="bi bi-credit-card me-1"></i>Cuenta Bancaria ID:</strong><br>
                        <span class="text-muted">@Model.TransactionToEdit.BankAccountID</span>
                    </div>
                    
                    <hr>
                    
                    <div class="mb-3">
                        <strong><i class="bi bi-flag me-1"></i>Estado Actual:</strong><br>
                        @{
                            var statusClass = Model.TransactionToEdit.TransactionStatus switch
                            {
                                "Completed" => "bg-success",
                                "Pending" => "bg-warning text-dark",
                                "PendingUserApproval" => "bg-warning text-dark",
                                "Processing" => "bg-info text-white",
                                "Failed" => "bg-danger",
                                "Cancelled" => "bg-secondary",
                                "Rejected" => "bg-danger",
                                _ => "bg-secondary"
                            };
                        }
                        <span class="badge @statusClass mt-1">
                            @EditTransactionModel.EstadoEspanol(Model.TransactionToEdit.TransactionStatus)
                        </span>
                    </div>
                    
                    @if (Model.TransactionToEdit.GrossAmount > 0)
                    {
                        <hr>
                        <h6 class="text-primary"><i class="bi bi-calculator me-1"></i>Cálculos Automáticos</h6>
                        
                        <div class="mb-2">
                            <strong>% Impuesto:</strong> 
                            <span class="badge bg-info">@((Model.TransactionToEdit.GrossAmount > 0 ? (Model.TransactionToEdit.SalesTaxAmount / Model.TransactionToEdit.GrossAmount) * 100 : 0).ToString("0.0"))%</span>
                        </div>
                        <div class="mb-2">
                            <strong>% Comisión:</strong> 
                            <span class="badge bg-warning text-dark">@((Model.TransactionToEdit.NetAmount > 0 ? (Model.TransactionToEdit.CommissionApplied / Model.TransactionToEdit.NetAmount) * 100 : 0).ToString("0.0"))%</span>
                        </div>
                        <div class="mb-2">
                            <strong>Diferencia Bruto-Neto:</strong><br>
                            <span class="text-muted">₡@((Model.TransactionToEdit.GrossAmount - Model.TransactionToEdit.NetAmount).ToString("N0"))</span>
                        </div>
                    }
                    
                    @if (Model.TransactionToEdit.MerchantPromotionID.HasValue || Model.TransactionToEdit.FinancialPromotionID.HasValue)
                    {
                        <hr>
                        <h6 class="text-primary"><i class="bi bi-tag me-1"></i>Promociones Aplicadas</h6>
                        
                        @if (Model.TransactionToEdit.MerchantPromotionID.HasValue)
                        {
                            <div class="mb-2">
                                <strong><i class="bi bi-shop me-1"></i>Promoción Comercio:</strong><br>
                                <span class="badge bg-success">#@Model.TransactionToEdit.MerchantPromotionID</span>
                            </div>
                        }
                        @if (Model.TransactionToEdit.FinancialPromotionID.HasValue)
                        {
                            <div class="mb-2">
                                <strong><i class="bi bi-bank me-1"></i>Promoción Financiera:</strong><br>
                                <span class="badge bg-primary">#@Model.TransactionToEdit.FinancialPromotionID</span>
                            </div>
                        }
                    }
                    
                    <hr>
                    <div class="text-center">
                        <small class="text-muted">
                            <i class="bi bi-info-circle me-1"></i>
                            Los campos en gris son de solo lectura por seguridad
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>