@page
@model WebApp.Pages.Administrator.EditFinancialPromotionModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Editar Promoción Financiera";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h1 class="mb-4"><i class="bi bi-percent me-2"></i>Editar Promoción Financiera</h1>

            @if (!string.IsNullOrEmpty(Model.Message))
            {
                <div class="alert alert-warning alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>@Model.Message
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
        </div>
    </div>

    <div class="row">
        <div class="col-xl-8 col-lg-7 col-md-12 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h7 class="mb-0"><i class="bi bi-percent me-2"></i>Información de la Promoción</h7>
                </div>
                <div class="card-body">
                    <form method="post" id="editPromotionForm">
                        <input type="hidden" asp-for="PromotionToEdit.ID" />
                        <input type="hidden" asp-for="PromotionToEdit.FinancialPromotionImage" id="hiddenPromotionImage" />
                        
                        <!-- Imagen de la Promoción Section -->
                        <div class="row">
                            <div class="col-12 mb-3">
                                <label class="form-label fw-bold">Imagen de la Promoción</label>
                                <div class="p-3 bg-light rounded">
                                    <input type="file" class="form-control mb-2" id="promotionImageFile" accept="image/*">
                                    <button type="button" class="btn btn-primary btn-sm" id="btnUploadPromotionImage">
                                        <i class="bi bi-cloud-upload me-1"></i>Subir Nueva Imagen
                                    </button>
                                </div>
                            </div>
                        </div>
                        
                        <hr class="my-4">
                        
                        <div class="row">
                            <div class="col-xl-6 col-lg-12 col-md-6 mb-3">
                                <label asp-for="PromotionToEdit.FinancialPromotionName" class="form-label fw-bold">
                                    <i class="bi bi-percent me-1"></i>Nombre de la Promoción
                                </label>
                                <input asp-for="PromotionToEdit.FinancialPromotionName" class="form-control" required />
                            </div>
                            <div class="col-xl-6 col-lg-12 col-md-6 mb-3">
                                <label asp-for="PromotionToEdit.PromotionType" class="form-label fw-bold">
                                    <i class="bi bi-card-list me-1"></i>Tipo de Promoción
                                </label>
                                <input asp-for="PromotionToEdit.PromotionType" class="form-control" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-xl-6 col-lg-12 col-md-6 mb-3">
                                <label asp-for="PromotionToEdit.DiscountPercentage" class="form-label fw-bold">
                                    <i class="bi bi-percent me-1"></i>Porcentaje de Descuento
                                </label>
                                <input asp-for="PromotionToEdit.DiscountPercentage" type="number" step="0.01" min="0" max="100" class="form-control" />
                            </div>
                            <div class="col-xl-6 col-lg-12 col-md-6 mb-3">
                                <label asp-for="PromotionToEdit.MaxRefund" class="form-label fw-bold">
                                    <i class="bi bi-currency-dollar me-1"></i>Reembolso Máximo
                                </label>
                                <input asp-for="PromotionToEdit.MaxRefund" type="number" step="0.01" min="0" class="form-control" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-xl-6 col-lg-12 col-md-6 mb-3">
                                <label asp-for="PromotionToEdit.StartDate" class="form-label fw-bold">
                                    <i class="bi bi-calendar-plus me-1"></i>Fecha de Inicio
                                </label>
                                <input asp-for="PromotionToEdit.StartDate" type="datetime-local" class="form-control" />
                            </div>
                            <div class="col-xl-6 col-lg-12 col-md-6 mb-3">
                                <label asp-for="PromotionToEdit.EndDate" class="form-label fw-bold">
                                    <i class="bi bi-calendar-x me-1"></i>Fecha de Fin
                                </label>
                                <input asp-for="PromotionToEdit.EndDate" type="datetime-local" class="form-control" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-xl-6 col-lg-12 col-md-6 mb-3">
                                <label asp-for="PromotionToEdit.AvailableQuantity" class="form-label fw-bold">
                                    <i class="bi bi-box me-1"></i>Cantidad Disponible
                                </label>
                                <input asp-for="PromotionToEdit.AvailableQuantity" type="number" min="0" class="form-control" />
                            </div>
                            <div class="col-xl-6 col-lg-12 col-md-6 mb-3">
                                <label asp-for="PromotionToEdit.ValidationStatus" class="form-label fw-bold">
                                    <i class="bi bi-check-circle me-1"></i>Estado
                                </label>
                                <select asp-for="PromotionToEdit.ValidationStatus" class="form-select">
                                    <option value="Active">Activo</option>
                                    <option value="Inactive">Inactivo</option>
                                </select>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-12 mb-3">
                                <label asp-for="PromotionToEdit.FinancialPromotionDescription" class="form-label fw-bold">
                                    <i class="bi bi-card-text me-1"></i>Descripción
                                </label>
                                <textarea asp-for="PromotionToEdit.FinancialPromotionDescription" class="form-control" rows="3"></textarea>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-12 mb-3">
                                <label asp-for="PromotionToEdit.FinancialPromotionTerms" class="form-label fw-bold">
                                    <i class="bi bi-file-text me-1"></i>Términos y Condiciones
                                </label>
                                <textarea asp-for="PromotionToEdit.FinancialPromotionTerms" class="form-control" rows="4"></textarea>
                            </div>
                        </div>

                        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center mt-4 pt-3 border-top gap-2">
                            <a href="/Administrator/AdministratorPanelPromotions" class="btn btn-secondary w-100 w-sm-auto">
                                <i class="bi bi-arrow-left me-1"></i>Volver
                            </a>
                            <button type="submit" class="btn btn-primary w-100 w-sm-auto">
                                <i class="bi bi-check-lg me-1"></i>Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        
        <div class="col-xl-4 col-lg-5 col-md-12">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <h7 class="mb-0"><i class="bi bi-info-circle me-2"></i>Información Adicional</h7>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <strong><i class="bi bi-hash me-1"></i>ID:</strong> 
                        <span class="badge bg-secondary">@Model.PromotionToEdit.ID</span>
                    </div>
                    <div class="mb-3">
                        <strong><i class="bi bi-bank me-1"></i>Entidad Financiera ID:</strong> 
                        <span class="badge bg-info">@Model.PromotionToEdit.FinancialEntityID</span>
                    </div>
                    @if (Model.PromotionToEdit.CreatedAt != DateTime.MinValue)
                    {
                        <div class="mb-3">
                            <strong><i class="bi bi-calendar-plus me-1"></i>Creada:</strong><br>
                            <span class="text-muted">@Model.PromotionToEdit.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                    }
                    
                    <hr>
                    <div class="text-center mb-3">
                        <h6 class="text-primary"><i class="bi bi-image me-1"></i>Vista Previa</h6>
                        <div class="border rounded p-3 bg-light">
                            <img id="promotionImagePreview" src="@(Model.PromotionToEdit.FinancialPromotionImage ?? "https://picsum.photos/seed/financial-promotion/300")" 
                                 class="img-fluid rounded" alt="Imagen de la promoción" style="max-height: 200px; width: 100%; object-fit: cover;">
                        </div>
                    </div>

                    <hr>
                    <div class="mb-3">
                        <h6 class="text-primary"><i class="bi bi-calendar-range me-1"></i>Estado de la Promoción</h6>
                        @if (Model.PromotionToEdit.StartDate <= DateTime.Now && Model.PromotionToEdit.EndDate >= DateTime.Now)
                        {
                            <div class="alert alert-success py-2">
                                <i class="bi bi-check-circle me-1"></i>Promoción vigente
                            </div>
                        }
                        else if (Model.PromotionToEdit.EndDate < DateTime.Now)
                        {
                            <div class="alert alert-danger py-2">
                                <i class="bi bi-x-circle me-1"></i>Promoción expirada
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning py-2">
                                <i class="bi bi-clock me-1"></i>Promoción no iniciada
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Funcionalidad de subida de imagen de promoción
            document.getElementById('btnUploadPromotionImage').addEventListener('click', function () {
                var fileInput = document.getElementById('promotionImageFile');
                var file = fileInput.files[0];
                if (!file) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Selecciona una imagen primero.',
                        confirmButtonClass: 'btn btn-primary'
                    });
                    return;
                }
                
                var formData = new FormData();
                formData.append('photo', file);
                
                // Mostrar loading
                Swal.fire({
                    title: '<i class="bi bi-cloud-upload"></i> Subiendo imagen...',
                    html: 'Por favor espera mientras se procesa la imagen.',
                    allowOutsideClick: false,
                    showConfirmButton: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });
                
                fetch('https://p2wallet-api-eyefddgeeda9c2fk.eastus-01.azurewebsites.net/api/cloudinary/Save', {
                    method: 'POST',
                    body: formData
                })
                .then(response => response.json())
                .then(data => {
                    var url = data.secure_url || data.url;
                    if (url) {
                        document.getElementById('hiddenPromotionImage').value = url;
                        // Actualizar la vista previa en el panel lateral
                        document.getElementById('promotionImagePreview').src = url;
                        Swal.fire({
                            icon: 'success',
                            title: '¡Éxito!',
                            text: 'Imagen subida correctamente.',
                            confirmButtonClass: 'btn btn-success'
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'No se pudo obtener la URL de la imagen.',
                            confirmButtonClass: 'btn btn-danger'
                        });
                    }
                })
                .catch(() => {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Error al subir la imagen.',
                        confirmButtonClass: 'btn btn-danger'
                    });
                });
            });
        });
    </script>
}