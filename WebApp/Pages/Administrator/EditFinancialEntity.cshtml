@page
@model WebApp.Pages.Administrator.EditFinancialEntityModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Editar Entidad Financiera";
}

<h1 class="mb-4">Editar Entidad Financiera</h1>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        @Model.Message
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0">Información de la Entidad Financiera</h6>
            </div>
            <div class="card-body">
                <form method="post">
                    <input type="hidden" asp-for="EntityToEdit.ID" />
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="EntityToEdit.EntityName" class="form-label">Nombre de la Entidad</label>
                            <input asp-for="EntityToEdit.EntityName" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="EntityToEdit.TaxID" class="form-label">Tax ID</label>
                            <input asp-for="EntityToEdit.TaxID" class="form-control" required />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="EntityToEdit.Email" class="form-label">Email</label>
                            <input asp-for="EntityToEdit.Email" type="email" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="EntityToEdit.ContactPhone" class="form-label">Teléfono</label>
                            <input asp-for="EntityToEdit.ContactPhone" class="form-control" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="EntityToEdit.CommissionPercentage" class="form-label">Porcentaje de Comisión</label>
                            <input asp-for="EntityToEdit.CommissionPercentage" type="number" step="0.01" min="0" max="100" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="EntityToEdit.ValidationStatus" class="form-label">Estado</label>
                            <select asp-for="EntityToEdit.ValidationStatus" class="form-select">
                                <option value="Active">Activo</option>
                                <option value="Inactive">Inactivo</option>
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="EntityToEdit.Latitude" class="form-label">Latitud</label>
                            <input asp-for="EntityToEdit.Latitude" type="number" step="any" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="EntityToEdit.Longitude" class="form-label">Longitud</label>
                            <input asp-for="EntityToEdit.Longitude" type="number" step="any" class="form-control" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12 mb-3">
                            <label asp-for="EntityToEdit.LogoImage" class="form-label">URL del Logo</label>
                            <input asp-for="EntityToEdit.LogoImage" type="url" class="form-control" />
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a href="/Administrator/AdministratorPanelFinancialEntities" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Volver
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save"></i> Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0">Información Adicional</h6>
            </div>
            <div class="card-body">
                <p><strong>ID:</strong> @Model.EntityToEdit.ID</p>
                
                @if (!string.IsNullOrEmpty(Model.EntityToEdit.LogoImage))
                {
                    <div class="text-center">
                        <img src="@Model.EntityToEdit.LogoImage" class="img-fluid rounded" alt="Logo de la entidad" style="max-height: 200px;">
                    </div>
                }
                else
                {
                    <div class="text-center text-muted">
                        <i class="bi bi-bank" style="font-size: 4rem;"></i>
                        <p>Sin logo</p>
                    </div>
                }

                @if (Model.EntityToEdit.Latitude != 0 || Model.EntityToEdit.Longitude != 0)
                {
                    <hr>
                    <p><strong>Ubicación:</strong></p>
                    <p>Lat: @Model.EntityToEdit.Latitude.ToString("0.000000")</p>
                    <p>Lng: @Model.EntityToEdit.Longitude.ToString("0.000000")</p>
                }
            </div>
        </div>
    </div>
</div>