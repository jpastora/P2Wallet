@page
@model WebApp.Pages.Administrator.EditFinancialEntityModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Editar Entidad Financiera";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h1 class="mb-4"><i class="bi bi-bank me-2"></i>Editar Entidad Financiera</h1>

            @if (!string.IsNullOrEmpty(Model.Message))
            {
                <div class="alert alert-warning alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>@Model.Message
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
        </div>
    </div>

    <div class="row">
        <div class="col-xl-8 col-lg-7 col-md-12 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h7 class="mb-0"><i class="bi bi-bank me-2"></i>Información de la Entidad Financiera</h7>
                </div>
                <div class="card-body">
                    <form method="post" id="editEntityForm">
                        <input type="hidden" asp-for="EntityToEdit.ID" />
                        <input type="hidden" asp-for="EntityToEdit.LogoImage" id="hiddenLogoImage" />
                        
                        <!-- Logo Section -->
                        <div class="row">
                            <div class="col-12 mb-3">
                                <label class="form-label fw-bold">Logo de la Entidad</label>
                                <div class="p-3 bg-light rounded">
                                    <input type="file" class="form-control mb-2" id="logoFile" accept="image/*">
                                    <button type="button" class="btn btn-primary btn-sm" id="btnUploadLogo">
                                        <i class="bi bi-cloud-upload me-1"></i>Subir Nuevo Logo
                                    </button>
                                </div>
                            </div>
                        </div>
                        
                        <hr class="my-4">
                        
                        <div class="row">
                            <div class="col-xl-6 col-lg-12 col-md-6 mb-3">
                                <label asp-for="EntityToEdit.EntityName" class="form-label fw-bold">
                                    <i class="bi bi-bank me-1"></i>Nombre de la Entidad
                                </label>
                                <input asp-for="EntityToEdit.EntityName" class="form-control" required />
                            </div>
                            <div class="col-xl-6 col-lg-12 col-md-6 mb-3">
                                <label asp-for="EntityToEdit.TaxID" class="form-label fw-bold">
                                    <i class="bi bi-file-text me-1"></i>Tax ID
                                </label>
                                <input asp-for="EntityToEdit.TaxID" class="form-control" required />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-xl-6 col-lg-12 col-md-6 mb-3">
                                <label asp-for="EntityToEdit.Email" class="form-label fw-bold">
                                    <i class="bi bi-envelope me-1"></i>Email
                                </label>
                                <input asp-for="EntityToEdit.Email" type="email" class="form-control" required />
                            </div>
                            <div class="col-xl-6 col-lg-12 col-md-6 mb-3">
                                <label asp-for="EntityToEdit.ContactPhone" class="form-label fw-bold">
                                    <i class="bi bi-telephone me-1"></i>Teléfono
                                </label>
                                <input asp-for="EntityToEdit.ContactPhone" class="form-control" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-xl-6 col-lg-12 col-md-6 mb-3">
                                <label asp-for="EntityToEdit.CommissionPercentage" class="form-label fw-bold">
                                    <i class="bi bi-percent me-1"></i>Porcentaje de Comisión
                                </label>
                                <input asp-for="EntityToEdit.CommissionPercentage" type="number" step="0.01" min="0" max="100" class="form-control" />
                            </div>
                            <div class="col-xl-6 col-lg-12 col-md-6 mb-3">
                                <label asp-for="EntityToEdit.ValidationStatus" class="form-label fw-bold">
                                    <i class="bi bi-check-circle me-1"></i>Estado
                                </label>
                                <select asp-for="EntityToEdit.ValidationStatus" class="form-select">
                                    <option value="Active">Activo</option>
                                    <option value="Inactive">Inactivo</option>
                                </select>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-xl-6 col-lg-12 col-md-6 mb-3">
                                <label asp-for="EntityToEdit.Latitude" class="form-label fw-bold">
                                    <i class="bi bi-geo-alt me-1"></i>Latitud
                                </label>
                                <input asp-for="EntityToEdit.Latitude" type="number" step="any" class="form-control" />
                            </div>
                            <div class="col-xl-6 col-lg-12 col-md-6 mb-3">
                                <label asp-for="EntityToEdit.Longitude" class="form-label fw-bold">
                                    <i class="bi bi-geo-alt me-1"></i>Longitud
                                </label>
                                <input asp-for="EntityToEdit.Longitude" type="number" step="any" class="form-control" />
                            </div>
                        </div>

                        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center mt-4 pt-3 border-top gap-2">
                            <a href="/Administrator/AdministratorPanelFinancialEntities" class="btn btn-secondary w-100 w-sm-auto">
                                <i class="bi bi-arrow-left me-1"></i>Volver
                            </a>
                            <button type="submit" class="btn btn-primary w-100 w-sm-auto">
                                <i class="bi bi-check-lg me-1"></i>Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        
        <div class="col-xl-4 col-lg-5 col-md-12">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <h7 class="mb-0"><i class="bi bi-info-circle me-2"></i>Información Adicional</h7>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <strong><i class="bi bi-hash me-1"></i>ID:</strong> 
                        <span class="badge bg-secondary">@Model.EntityToEdit.ID</span>
                    </div>
                    
                    <hr>
                    <div class="text-center mb-3">
                        <h6 class="text-primary"><i class="bi bi-image me-1"></i>Vista Previa del Logo</h6>
                        <div class="border rounded p-3 bg-light">
                            <img id="logoPreview" src="@(Model.EntityToEdit.LogoImage ?? "https://picsum.photos/seed/entity/300")" 
                                 class="img-fluid rounded" alt="Logo de la entidad" style="max-height: 200px; width: 100%; object-fit: cover;">
                        </div>
                    </div>

                    @if (Model.EntityToEdit.Latitude != 0 || Model.EntityToEdit.Longitude != 0)
                    {
                        <hr>
                        <div class="mb-3">
                            <h6 class="text-primary"><i class="bi bi-geo-alt me-1"></i>Ubicación</h6>
                            <p class="text-muted mb-1">
                                <strong>Lat:</strong> @Model.EntityToEdit.Latitude.ToString("0.000000")
                            </p>
                            <p class="text-muted">
                                <strong>Lng:</strong> @Model.EntityToEdit.Longitude.ToString("0.000000")
                            </p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Funcionalidad de subida de logo
            document.getElementById('btnUploadLogo').addEventListener('click', function () {
                var fileInput = document.getElementById('logoFile');
                var file = fileInput.files[0];
                if (!file) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Selecciona una imagen primero.',
                        confirmButtonClass: 'btn btn-primary'
                    });
                    return;
                }
                
                var formData = new FormData();
                formData.append('photo', file);
                
                // Mostrar loading
                Swal.fire({
                    title: '<i class="bi bi-cloud-upload"></i> Subiendo imagen...',
                    html: 'Por favor espera mientras se procesa la imagen.',
                    allowOutsideClick: false,
                    showConfirmButton: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });
                
                fetch('https://p2wallet-api-eyefddgeeda9c2fk.eastus-01.azurewebsites.net/api/cloudinary/Save', {
                    method: 'POST',
                    body: formData
                })
                .then(response => response.json())
                .then(data => {
                    var url = data.secure_url || data.url;
                    if (url) {
                        document.getElementById('hiddenLogoImage').value = url;
                        // Actualizar la vista previa en el panel lateral
                        document.getElementById('logoPreview').src = url;
                        Swal.fire({
                            icon: 'success',
                            title: '¡Éxito!',
                            text: 'Logo subido correctamente.',
                            confirmButtonClass: 'btn btn-success'
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'No se pudo obtener la URL del logo.',
                            confirmButtonClass: 'btn btn-danger'
                        });
                    }
                })
                .catch(() => {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Error al subir la imagen.',
                        confirmButtonClass: 'btn btn-danger'
                    });
                });
            });
        });
    </script>
}