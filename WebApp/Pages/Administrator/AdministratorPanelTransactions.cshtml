@page
@model WebApp.Pages.Administrator.AdministratorPanelTransactionsModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Administración de Transacciones";
}

<h1 class="mb-4">Administración de Transacciones</h1>

@if (!string.IsNullOrEmpty(TempData["SuccessMessage"]?.ToString()))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!string.IsNullOrEmpty(TempData["ErrorMessage"]?.ToString()))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Filtros y búsqueda -->
<div class="card p-3 mb-4">
    <form method="get" class="row g-3">
        <div class="col-md-3">
            <input type="text" class="form-control" name="searchTerm" 
                   value="@Model.SearchTerm" placeholder="Buscar por ID o comercio...">
        </div>
        <div class="col-md-3">
            <select name="statusFilter" class="form-select">
                <option value="">Todos los estados</option>
                <option value="Completed" selected="@(Model.StatusFilter == "Completed")">Completada</option>
                <option value="Pending" selected="@(Model.StatusFilter == "Pending")">Pendiente</option>
                <option value="Failed" selected="@(Model.StatusFilter == "Failed")">Fallida</option>
                <option value="Cancelled" selected="@(Model.StatusFilter == "Cancelled")">Cancelada</option>
            </select>
        </div>
        <div class="col-md-3">
            <input type="date" class="form-control" name="dateFilter" value="@Model.DateFilter?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-search"></i> Buscar
            </button>
        </div>
    </form>
</div>

<!-- Estadísticas rápidas -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card p-3 shadow-sm text-center">
            <h6 class="text-muted">Total Transacciones</h6>
            <h4 class="text-primary">@Model.TotalTransactions.ToString("N0")</h4>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3 shadow-sm text-center">
            <h6 class="text-muted">Volumen Total</h6>
            <h4 class="text-success">₡@Model.TotalVolume.ToString("N0")</h4>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3 shadow-sm text-center">
            <h6 class="text-muted">Comisiones</h6>
            <h4 class="text-warning">₡@Model.TotalCommissions.ToString("N0")</h4>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3 shadow-sm text-center">
            <h6 class="text-muted">Promedio</h6>
            <h4 class="text-info">₡@Model.AverageTransaction.ToString("N0")</h4>
        </div>
    </div>
</div>

<!-- Lista de transacciones -->
<div class="card">
    <div class="card-header">
        <h6 class="mb-0">
            <i class="bi bi-cash-stack me-2"></i>
            Lista de Transacciones (@Model.TotalTransactionsFound total)
        </h6>
    </div>
    <div class="card-body p-0">
        @if (Model.AllTransactions.Count > 0)
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Usuario</th>
                            <th>Comercio</th>
                            <th>Monto Bruto</th>
                            <th>Monto Neto</th>
                            <th>Comisión</th>
                            <th>Fecha</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var transaction in Model.AllTransactions)
                        {
                            var statusClass = transaction.TransactionStatus switch
                            {
                                "Completed" => "bg-success",
                                "Pending" => "bg-warning text-dark",
                                "Failed" => "bg-danger",
                                "Cancelled" => "bg-secondary",
                                _ => "bg-secondary"
                            };
                            
                            var statusText = AdministratorPanelTransactionsModel.EstadoEspanol(transaction.TransactionStatus);

                            <tr>
                                <td><strong>#@transaction.ID</strong></td>
                                <td>@Model.GetUserName(transaction.UserID)</td>
                                <td>@Model.GetMerchantName(transaction.MerchantID)</td>
                                <td>₡@transaction.GrossAmount.ToString("N0")</td>
                                <td>₡@transaction.NetAmount.ToString("N0")</td>
                                <td>₡@transaction.CommissionApplied.ToString("N0")</td>
                                <td>@transaction.Timestamp.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <span class="badge @statusClass">
                                        @statusText
                                    </span>
                                </td>
                                <td>
                                    @if (transaction.TransactionStatus != "Completed")
                                    {
                                        <form method="post" asp-page-handler="ChangeStatus" class="d-inline">
                                            <input type="hidden" name="transactionId" value="@transaction.ID" />
                                            <input type="hidden" name="newStatus" value="Completed" />
                                            <button type="submit" class="btn btn-sm btn-outline-success" title="Marcar como completada">
                                                <i class="bi bi-check-circle"></i>
                                            </button>
                                        </form>
                                        
                                        <form method="post" asp-page-handler="ChangeStatus" class="d-inline">
                                            <input type="hidden" name="transactionId" value="@transaction.ID" />
                                            <input type="hidden" name="newStatus" value="Failed" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Marcar como fallida">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        </form>
                                    }
                                    
                                    <a href="/Administrator/EditTransaction?transactionId=@transaction.ID" class="btn btn-sm btn-outline-primary ms-1">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <h5 class="text-muted">No se encontraron transacciones</h5>
            </div>
        }
    </div>
</div>

<!-- Paginación simple -->
@if (Model.TotalPages > 1)
{
    <nav class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link" href="?searchTerm=@Model.SearchTerm&statusFilter=@Model.StatusFilter&dateFilter=@Model.DateFilter?.ToString("yyyy-MM-dd")&currentPage=@Model.PreviousPage">
                    Anterior
                </a>
            </li>
            
            <li class="page-item active">
                <span class="page-link">
                    Página @Model.CurrentPage de @Model.TotalPages
                </span>
            </li>
            
            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link" href="?searchTerm=@Model.SearchTerm&statusFilter=@Model.StatusFilter&dateFilter=@Model.DateFilter?.ToString("yyyy-MM-dd")&currentPage=@Model.NextPage">
                    Siguiente
                </a>
            </li>
        </ul>
    </nav>
}