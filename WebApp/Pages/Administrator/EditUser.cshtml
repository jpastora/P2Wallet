@page
@model WebApp.Pages.Administrator.EditUserModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Editar Usuario";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h1 class="mb-4"><i class="bi bi-person-gear me-2"></i>Editar Usuario</h1>

            @if (!string.IsNullOrEmpty(Model.Message))
            {
                <div class="alert alert-warning alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>@Model.Message
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
        </div>
    </div>

    <div class="row">
        <div class="col-xl-8 col-lg-7 col-md-12 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h7 class="mb-0"><i class="bi bi-person-circle me-2"></i>Información del Usuario</h7>
                </div>
                <div class="card-body">
                    <form method="post" id="editUserForm">
                        <input type="hidden" asp-for="UserToEdit.ID" />
                        <input type="hidden" asp-for="UserToEdit.ProfilePhotoUrl" id="hiddenProfilePhotoUrl" />
                        
                        <!-- Foto de Perfil Section -->
                        <div class="row">
                            <div class="col-12 mb-3">
                                <label class="form-label fw-bold">Foto de Perfil</label>
                                <div class="p-3 bg-light rounded">
                                    <input type="file" class="form-control mb-2" id="profilePhotoFile" accept="image/*">
                                    <button type="button" class="btn btn-primary btn-sm" id="btnUploadProfilePhoto">
                                        <i class="bi bi-cloud-upload me-1"></i>Subir Nueva Foto
                                    </button>
                                </div>
                            </div>
                        </div>
                        
                        <hr class="my-4">
                        
                        <div class="row">
                            <div class="col-xl-6 col-lg-12 col-md-6 mb-3">
                                <label asp-for="UserToEdit.FirstName" class="form-label fw-bold">
                                    <i class="bi bi-person me-1"></i>Nombre
                                </label>
                                <input asp-for="UserToEdit.FirstName" class="form-control" required />
                            </div>
                            <div class="col-xl-6 col-lg-12 col-md-6 mb-3">
                                <label asp-for="UserToEdit.LastName" class="form-label fw-bold">
                                    <i class="bi bi-person me-1"></i>Apellido
                                </label>
                                <input asp-for="UserToEdit.LastName" class="form-control" required />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-xl-6 col-lg-12 col-md-6 mb-3">
                                <label asp-for="UserToEdit.Email" class="form-label fw-bold">
                                    <i class="bi bi-envelope me-1"></i>Email
                                </label>
                                <input asp-for="UserToEdit.Email" type="email" class="form-control" required />
                            </div>
                            <div class="col-xl-6 col-lg-12 col-md-6 mb-3">
                                <label asp-for="UserToEdit.MobilePhone" class="form-label fw-bold">
                                    <i class="bi bi-telephone me-1"></i>Teléfono
                                </label>
                                <input asp-for="UserToEdit.MobilePhone" class="form-control" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-xl-6 col-lg-12 col-md-6 mb-3">
                                <label asp-for="UserToEdit.IDNumber" class="form-label fw-bold">
                                    <i class="bi bi-card-text me-1"></i>Número de Identificación
                                </label>
                                <input asp-for="UserToEdit.IDNumber" class="form-control" />
                            </div>
                            <div class="col-xl-6 col-lg-12 col-md-6 mb-3">
                                <label asp-for="UserToEdit.BirthDate" class="form-label fw-bold">
                                    <i class="bi bi-calendar me-1"></i>Fecha de Nacimiento
                                </label>
                                <input asp-for="UserToEdit.BirthDate" type="date" class="form-control" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-xl-6 col-lg-12 col-md-6 mb-3">
                                <label asp-for="UserToEdit.ValidationStatus" class="form-label fw-bold">
                                    <i class="bi bi-check-circle me-1"></i>Estado
                                </label>
                                <select asp-for="UserToEdit.ValidationStatus" class="form-select">
                                    <option value="Active">Activo</option>
                                    <option value="Inactive">Inactivo</option>
                                </select>
                            </div>
                            <div class="col-xl-6 col-lg-12 col-md-6 mb-3">
                                <label asp-for="UserToEdit.Role" class="form-label fw-bold">
                                    <i class="bi bi-shield-check me-1"></i>Rol
                                </label>
                                <select asp-for="UserToEdit.Role" class="form-select">
                                    <option value="User">Usuario</option>
                                    <option value="Admin">Administrador</option>
                                    <option value="Merchant">Comerciante</option>
                                    <option value="Entity">Entidad</option>
                                </select>
                            </div>
                        </div>

                        <hr class="my-4">
                        <h6 class="text-primary"><i class="bi bi-key me-2"></i>Cambiar Contraseña (Opcional)</h6>
                        <div class="row">
                            <div class="col-xl-6 col-lg-12 col-md-6 mb-3">
                                <label asp-for="UserToEdit.Password" class="form-label fw-bold">Nueva Contraseña</label>
                                <input asp-for="UserToEdit.Password" type="password" class="form-control" />
                                <small class="form-text text-muted">Dejar vacío para mantener la contraseña actual</small>
                            </div>
                            <div class="col-xl-6 col-lg-12 col-md-6 mb-3">
                                <label asp-for="ConfirmPassword" class="form-label fw-bold">Confirmar Contraseña</label>
                                <input asp-for="ConfirmPassword" type="password" class="form-control" />
                            </div>
                        </div>

                        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center mt-4 pt-3 border-top gap-2">
                            <a href="/Administrator/AdministratorPanelUsers" class="btn btn-secondary w-100 w-sm-auto">
                                <i class="bi bi-arrow-left me-1"></i>Volver
                            </a>
                            <button type="submit" class="btn btn-primary w-100 w-sm-auto">
                                <i class="bi bi-check-lg me-1"></i>Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        
        <div class="col-xl-4 col-lg-5 col-md-12">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <h6 class="mb-0"><i class="bi bi-info-circle me-2"></i>Información Adicional</h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <strong><i class="bi bi-hash me-1"></i>ID:</strong> 
                        <span class="badge bg-secondary">@Model.UserToEdit.ID</span>
                    </div>
                    <div class="mb-3">
                        <strong><i class="bi bi-calendar-plus me-1"></i>Creado:</strong><br>
                        <span class="text-muted">@(Model.UserToEdit.Created != DateTime.MinValue ? Model.UserToEdit.Created.ToString("dd/MM/yyyy HH:mm") : "N/A")</span>
                    </div>
                    <div class="mb-3">
                        <strong><i class="bi bi-calendar-check me-1"></i>Actualizado:</strong><br>
                        <span class="text-muted">@(Model.UserToEdit.Updated != DateTime.MinValue ? Model.UserToEdit.Updated.ToString("dd/MM/yyyy HH:mm") : "N/A")</span>
                    </div>
                    
                    <hr>
                    <div class="text-center mb-3">
                        <h6 class="text-primary"><i class="bi bi-image me-1"></i>Vista Previa</h6>
                        <div class="border rounded p-3 bg-light d-flex justify-content-center align-items-center" style="min-height: 220px;">
                            <img id="profilePhotoPreview" src="@(Model.UserToEdit.ProfilePhotoUrl ?? "https://picsum.photos/seed/perfil/300")" 
                                 class="img-fluid rounded-circle" alt="Foto de perfil" style="max-height: 200px; width: 200px; height: 200px; object-fit: cover;">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Funcionalidad de subida de foto de perfil
            document.getElementById('btnUploadProfilePhoto').addEventListener('click', function () {
                var fileInput = document.getElementById('profilePhotoFile');
                var file = fileInput.files[0];
                if (!file) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Selecciona una imagen primero.',
                        confirmButtonClass: 'btn btn-primary'
                    });
                    return;
                }
                
                var formData = new FormData();
                formData.append('photo', file);
                
                // Mostrar loading
                Swal.fire({
                    title: '<i class="bi bi-cloud-upload"></i> Subiendo imagen...',
                    html: 'Por favor espera mientras se procesa la imagen.',
                    allowOutsideClick: false,
                    showConfirmButton: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });
                
                fetch('https://p2wallet-api-eyefddgeeda9c2fk.eastus-01.azurewebsites.net/api/cloudinary/Save', {
                    method: 'POST',
                    body: formData
                })
                .then(response => response.json())
                .then(data => {
                    var url = data.secure_url || data.url;
                    if (url) {
                        document.getElementById('hiddenProfilePhotoUrl').value = url;
                        // Actualizar la vista previa en el panel lateral
                        document.getElementById('profilePhotoPreview').src = url;
                        Swal.fire({
                            icon: 'success',
                            title: '¡Éxito!',
                            text: 'Foto de perfil subida correctamente.',
                            confirmButtonClass: 'btn btn-success'
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'No se pudo obtener la URL de la foto.',
                            confirmButtonClass: 'btn btn-danger'
                        });
                    }
                })
                .catch(() => {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Error al subir la imagen.',
                        confirmButtonClass: 'btn btn-danger'
                    });
                });
            });
        });
    </script>
}