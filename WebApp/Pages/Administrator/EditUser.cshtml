@page
@model WebApp.Pages.Administrator.EditUserModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Editar Usuario";
}

<h1 class="mb-4">Editar Usuario</h1>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        @Model.Message
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0">Información del Usuario</h6>
            </div>
            <div class="card-body">
                <form method="post" id="editUserForm">
                    <input type="hidden" asp-for="UserToEdit.ID" />
                    <input type="hidden" asp-for="UserToEdit.ProfilePhotoUrl" id="hiddenProfilePhotoUrl" />
                    
                    <!-- Foto de Perfil Section -->
                    <div class="row">
                        <div class="col-12 mb-3">
                            <label class="form-label">Foto de Perfil</label>
                            <div class="d-flex align-items-center gap-3">
                                <div class="text-center">
                                    <img id="profilePhotoPreview" src="@(Model.UserToEdit.ProfilePhotoUrl ?? "https://picsum.photos/seed/perfil/120")" 
                                         alt="Foto de perfil" class="rounded-circle" style="width:80px;height:80px;object-fit:cover;">
                                </div>
                                <div class="flex-grow-1">
                                    <input type="file" class="form-control mb-2" id="profilePhotoFile" accept="image/*">
                                    <button type="button" class="btn btn-outline-primary btn-sm" id="btnUploadProfilePhoto">
                                        <i class="bi bi-cloud-upload"></i> Subir Nueva Foto
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <hr>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="UserToEdit.FirstName" class="form-label">Nombre</label>
                            <input asp-for="UserToEdit.FirstName" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="UserToEdit.LastName" class="form-label">Apellido</label>
                            <input asp-for="UserToEdit.LastName" class="form-control" required />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="UserToEdit.Email" class="form-label">Email</label>
                            <input asp-for="UserToEdit.Email" type="email" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="UserToEdit.MobilePhone" class="form-label">Teléfono</label>
                            <input asp-for="UserToEdit.MobilePhone" class="form-control" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="UserToEdit.IDNumber" class="form-label">Número de Identificación</label>
                            <input asp-for="UserToEdit.IDNumber" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="UserToEdit.BirthDate" class="form-label">Fecha de Nacimiento</label>
                            <input asp-for="UserToEdit.BirthDate" type="date" class="form-control" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="UserToEdit.ValidationStatus" class="form-label">Estado</label>
                            <select asp-for="UserToEdit.ValidationStatus" class="form-select">
                                <option value="Active">Activo</option>
                                <option value="Inactive">Inactivo</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="UserToEdit.Role" class="form-label">Rol</label>
                            <select asp-for="UserToEdit.Role" class="form-select">
                                <option value="User">Usuario</option>
                                <option value="Admin">Administrador</option>
                                <option value="Merchant">Comerciante</option>
                                <option value="Entity">Entidad</option>
                            </select>
                        </div>
                    </div>

                    <hr>
                    <h6>Cambiar Contraseña (Opcional)</h6>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="UserToEdit.Password" class="form-label">Nueva Contraseña</label>
                            <input asp-for="UserToEdit.Password" type="password" class="form-control" />
                            <small class="form-text text-muted">Dejar vacío para mantener la contraseña actual</small>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ConfirmPassword" class="form-label">Confirmar Contraseña</label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" />
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a href="/Administrator/AdministratorPanelUsers" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Volver
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save"></i> Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0">Información Adicional</h6>
            </div>
            <div class="card-body">
                <p><strong>ID:</strong> @Model.UserToEdit.ID</p>
                <p><strong>Creado:</strong> @(Model.UserToEdit.Created != DateTime.MinValue ? Model.UserToEdit.Created.ToString("dd/MM/yyyy") : "N/A")</p>
                <p><strong>Actualizado:</strong> @(Model.UserToEdit.Updated != DateTime.MinValue ? Model.UserToEdit.Updated.ToString("dd/MM/yyyy") : "N/A")</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Funcionalidad de subida de foto de perfil
            document.getElementById('btnUploadProfilePhoto').addEventListener('click', function () {
                var fileInput = document.getElementById('profilePhotoFile');
                var file = fileInput.files[0];
                if (!file) {
                    Swal.fire('Error', 'Selecciona una imagen primero.', 'error');
                    return;
                }
                
                var formData = new FormData();
                formData.append('photo', file);
                
                // Mostrar loading
                Swal.fire({
                    title: 'Subiendo imagen...',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });
                
                fetch('https://p2wallet-api-eyefddgeeda9c2fk.eastus-01.azurewebsites.net/api/cloudinary/Save', {
                    method: 'POST',
                    body: formData
                })
                .then(response => response.json())
                .then(data => {
                    var url = data.secure_url || data.url;
                    if (url) {
                        document.getElementById('hiddenProfilePhotoUrl').value = url;
                        document.getElementById('profilePhotoPreview').src = url;
                        Swal.fire('¡Éxito!', 'Foto de perfil subida correctamente.', 'success');
                    } else {
                        Swal.fire('Error', 'No se pudo obtener la URL de la foto.', 'error');
                    }
                })
                .catch(() => {
                    Swal.fire('Error', 'Error al subir la imagen.', 'error');
                });
            });
        });
    </script>
}