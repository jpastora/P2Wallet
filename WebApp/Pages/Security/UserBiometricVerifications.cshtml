@page
@model WebApp.Pages.Security.UserBiometricVerificationsModel
@{
    ViewData["Title"] = "Validación de Usuario";
}

<div class="container py-5 text-center">

    <h3 class="mb-4">Verificación Biométrica</h3>

    <form id="verifyForm">

        <!-- Selfie -->
        <div id="selfieSection" class="mb-5">
            <h5>1. Captura tu Selfie</h5>
            <video id="selfieVideo" autoplay playsinline muted></video>
            <canvas id="selfieCanvas" class="d-none"></canvas>

            <button id="btnTakeSelfie" class="btn btn-primary mt-3" type="button" onclick="takePhoto('selfie')">Tomar Selfie</button>
            <button id="btnConfirmSelfie" class="btn btn-success mt-3 d-none" type="button" onclick="confirmPhoto('selfie')">Confirmar</button>
            <button id="btnRetakeSelfie" class="btn btn-secondary mt-3 d-none" type="button" onclick="retakePhoto('selfie')">Tomar de Nuevo</button>

            <input type="hidden" id="selfieInput" name="SelfieImage" />
        </div>

        <!-- Frente de la cédula -->
        <div id="frontIdSection" class="mb-5 d-none">
            <h5>2. Foto del Frente de la Cédula</h5>
            <div class="id-frame mb-2">
                <video id="frontIdVideo" autoplay playsinline muted></video>
                <canvas id="frontIdCanvas" class="d-none"></canvas>
            </div>

            <button id="btnTakeFront" class="btn btn-primary mt-3" type="button" onclick="takePhoto('front')">Tomar Frente</button>
            <button id="btnConfirmFront" class="btn btn-success mt-3 d-none" type="button" onclick="confirmPhoto('front')">Confirmar</button>
            <button id="btnRetakeFront" class="btn btn-secondary mt-3 d-none" type="button" onclick="retakePhoto('front')">Tomar de Nuevo</button>

            <input type="hidden" id="frontIdInput" name="IdFrontImage" />
        </div>

        <!-- Reverso de la cédula -->
        <div id="backIdSection" class="mb-5 d-none">
            <h5>3. Foto del Reverso de la Cédula</h5>
            <div class="id-frame mb-2">
                <video id="backIdVideo" autoplay playsinline muted></video>
                <canvas id="backIdCanvas" class="d-none"></canvas>
            </div>

            <button id="btnTakeBack" class="btn btn-primary mt-3" type="button" onclick="takePhoto('back')">Tomar Reverso</button>
            <button id="btnConfirmBack" class="btn btn-success mt-3 d-none" type="button" onclick="confirmPhoto('back')">Confirmar</button>
            <button id="btnRetakeBack" class="btn btn-secondary mt-3 d-none" type="button" onclick="retakePhoto('back')">Tomar de Nuevo</button>

            <input type="hidden" id="backIdInput" name="IdBackImage" />
        </div>

        <!-- Resultado del servidor -->
        <div id="result" class="alert alert-info mt-3 d-none"></div>
    </form>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const verifyButton = document.getElementById("verifyButton");
            const resultDiv = document.getElementById("result");

            async function dataURLToBlob(dataURL) {
                const response = await fetch(dataURL);
                return await response.blob();
            }

            verifyButton.addEventListener("click", async function () {
                resultDiv.innerHTML = "Procesando verificación...";

                try {
                    const selfieDataURL = document.getElementById("selfie").src;
                    const idFrontDataURL = document.getElementById("id_front").src;
                    const idBackDataURL = document.getElementById("id_back").src;

                    const selfieBlob = await dataURLToBlob(selfieDataURL);
                    const idFrontBlob = await dataURLToBlob(idFrontDataURL);
                    const idBackBlob = await dataURLToBlob(idBackDataURL);

                    const formData = new FormData();
                    formData.append("selfie", selfieBlob, "selfie.jpg");
                    formData.append("id_image", idFrontBlob, "id_front.jpg");
                    formData.append("id_back", idBackBlob, "id_back.jpg");

                    const response = await fetch("http://localhost:5000/verify", {
                        method: "POST",
                        body: formData
                    });

                    const body = await response.json();

                    if (!response.ok) {
                        resultDiv.innerHTML = "<strong>Error:</strong> " + (body.error || "Error desconocido");
                        return;
                    }

                    // Mostrar resultado
                    resultDiv.innerHTML =
                        "<strong>Resultado:</strong> " + (body.verified ? "Verificación exitosa ✅" : "Verificación fallida ❌") + "<br>" +
                        "<strong>Distancia:</strong> " + body.distance + "<br>" +
                        "<strong>Threshold:</strong> " + body.threshold + "<br>" +
                        "<strong>Modelo:</strong> " + body.model + "<br><br>" +
                        "<strong>OCR:</strong><br>" +
                        "Cédula: " + body.ocr_data.numero_cedula + "<br>" +
                        "Nacimiento: " + body.ocr_data.fecha_nacimiento + "<br>" +
                        "Vencimiento: " + body.ocr_data.fecha_vencimiento;

                } catch (error) {
                    resultDiv.innerHTML = "<strong>Error de red:</strong> " + error.message;
                }
            });
        });
    </script>
}


