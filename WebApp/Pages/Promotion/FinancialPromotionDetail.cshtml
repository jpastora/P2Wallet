@page
@model WebApp.Pages.Promotion.FinancialPromotionDetailModel
@{
    ViewData["Title"] = Model.PromotionFound ? Model.PromotionInfo.FinancialPromotionName : "Promoción no encontrada";
}

<!-- Estilos específicos para detalle de promoción financiera -->
<style>
    .promotion-hero {
        background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);
        color: white;
        padding: 3rem 0 2rem;
        margin-bottom: 2rem;
    }
    
    .promotion-image {
        width: 100px;
        height: 100px;
        border-radius: 12px;
        object-fit: cover;
        border: 3px solid white;
        box-shadow: 0 2px 8px rgba(0,0,0,0.15);
    }
    
    .promotion-info-card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.1);
        overflow: hidden;
    }
    
    .discount-badge {
        font-size: 2rem;
        font-weight: bold;
        background: linear-gradient(45deg, #007bff, #0056b3);
        color: white;
        border-radius: 50%;
        width: 80px;
        height: 80px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 2px 8px rgba(0,0,0,0.2);
    }
    
    .entity-card {
        background: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 12px;
        padding: 1.5rem;
    }
    
    .back-button {
        position: sticky;
        top: 20px;
        z-index: 100;
    }
    
    @@media (max-width: 768px) {
        .promotion-hero {
            padding: 2rem 0 1rem;
        }
        
        .promotion-image {
            width: 70px;
            height: 70px;
        }
        
        .discount-badge {
            width: 60px;
            height: 60px;
            font-size: 1.5rem;
        }
    }
</style>

@if (!Model.PromotionFound)
{
    <!-- Promotion Not Found -->
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-6 text-center">
                <i class="bi bi-bank text-muted" style="font-size: 5rem;"></i>
                <h2 class="mt-4 text-muted">Promoción financiera no encontrada</h2>
                <p class="text-muted mb-4">@Model.Message</p>
                <a href="/" class="btn btn-primary">
                    <i class="bi bi-arrow-left me-2"></i>Volver al inicio
                </a>
            </div>
        </div>
    </div>
}
else
{
    <!-- Back Button -->
    <div class="container-fluid">
        <div class="back-button mt-3">
            <a href="javascript:history.back()" class="btn btn-outline-light">
                <i class="bi bi-arrow-left me-2"></i>Volver
            </a>
        </div>
    </div>

    <!-- Promotion Hero Section -->
    <section class="promotion-hero">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-2 text-center">
                    @if (!string.IsNullOrEmpty(Model.PromotionInfo.FinancialPromotionImage))
                    {
                        <img src="@Model.PromotionInfo.FinancialPromotionImage" 
                             alt="@Model.PromotionInfo.FinancialPromotionName" 
                             class="promotion-image">
                    }
                    else
                    {
                        <div class="promotion-image d-flex align-items-center justify-content-center bg-white text-primary">
                            <i class="@Model.GetPromotionTypeIcon()" style="font-size: 2rem;"></i>
                        </div>
                    }
                </div>
                <div class="col-md-8">
                    <h1 class="mb-3">@Model.PromotionInfo.FinancialPromotionName</h1>
                    <div class="mb-3">
                        <span class="badge @Model.GetPromotionStatusBadgeClass() me-2">
                            @Model.GetPromotionStatusText()
                        </span>
                        <span class="badge bg-light text-dark">@Model.GetPromotionTypeText()</span>
                    </div>
                    <p class="lead mb-3">@Model.PromotionInfo.FinancialPromotionDescription</p>
                    
                    @if (Model.IsPromotionActive())
                    {
                        <div class="alert alert-light border border-white">
                            <i class="bi bi-check-circle me-2"></i>
                            <strong>¡Promoción financiera vigente!</strong> 
                            @if (Model.GetDaysRemaining() > 0)
                            {
                                <span>Quedan @Model.GetDaysRemaining() días para aprovecharla.</span>
                            }
                        </div>
                    }
                </div>
                <div class="col-md-2 text-center">
                    <div class="discount-badge">
                        @Model.PromotionInfo.DiscountPercentage.ToString("0")%
                    </div>
                    <p class="mt-2 mb-0 small">de beneficio</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Promotion Details -->
    <section class="py-4">
        <div class="container">
            <div class="row">
                <div class="col-md-8">
                    <!-- Información de la Promoción -->
                    <div class="promotion-info-card card mb-4">
                        <div class="card-header bg-primary text-white">
                            <h4 class="mb-0">
                                <i class="bi bi-info-circle me-2"></i>Detalles de la Promoción
                            </h4>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <h6 class="text-muted mb-1">Tipo de Promoción</h6>
                                        <p class="mb-0">
                                            <i class="@Model.GetPromotionTypeIcon() me-2 text-primary"></i>
                                            @Model.PromotionInfo.PromotionType
                                        </p>
                                    </div>
                                    <div class="mb-3">
                                        <h6 class="text-muted mb-1">Beneficio</h6>
                                        <p class="mb-0 text-primary fw-bold fs-4">
                                            @Model.PromotionInfo.DiscountPercentage.ToString("0.0")%
                                        </p>
                                    </div>
                                    <div class="mb-3">
                                        <h6 class="text-muted mb-1">Beneficio Máximo</h6>
                                        <p class="mb-0">
                                            <i class="bi bi-currency-dollar me-2"></i>
                                            ₡@Model.PromotionInfo.MaxRefund.ToString("N0")
                                        </p>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <h6 class="text-muted mb-1">Disponibles</h6>
                                        <p class="mb-0">
                                            <i class="bi bi-box me-2"></i>
                                            @Model.PromotionInfo.AvailableQuantity aplicaciones
                                        </p>
                                    </div>
                                    <div class="mb-3">
                                        <h6 class="text-muted mb-1">Fecha de Inicio</h6>
                                        <p class="mb-0">
                                            <i class="bi bi-calendar-check me-2"></i>
                                            @Model.PromotionInfo.StartDate.ToString("dd/MM/yyyy")
                                        </p>
                                    </div>
                                    <div class="mb-3">
                                        <h6 class="text-muted mb-1">Fecha de Vencimiento</h6>
                                        <p class="mb-0">
                                            <i class="bi bi-calendar-x me-2"></i>
                                            @Model.PromotionInfo.EndDate.ToString("dd/MM/yyyy")
                                        </p>
                                    </div>
                                </div>
                            </div>
                            
                            @if (!string.IsNullOrEmpty(Model.PromotionInfo.FinancialPromotionTerms))
                            {
                                <hr>
                                <h6 class="text-muted mb-2">Términos y Condiciones</h6>
                                <div class="alert alert-light border-start border-4 border-primary">
                                    <small>@Model.PromotionInfo.FinancialPromotionTerms</small>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                
                <div class="col-md-4">
                    <!-- Información de la Entidad -->
                    <div class="entity-card mb-4">
                        <h5 class="mb-3">
                            <i class="bi bi-bank text-primary me-2"></i>@Model.GetEntityType()
                        </h5>
                        <div class="text-center mb-3">
                            @if (!string.IsNullOrEmpty(Model.EntityInfo.LogoImage))
                            {
                                <img src="@Model.EntityInfo.LogoImage" alt="@Model.EntityInfo.EntityName"
                                     class="rounded" style="width: 110px; height: 60px; object-fit: cover;">
                            }
                            else
                            {
                                <div class="bg-primary text-white rounded d-flex align-items-center justify-content-center"
                                     style="width: 110px; height: 60px; margin: 0 auto;">
                                    <i class="bi bi-bank" style="font-size: 1.5rem;"></i>
                                </div>
                            }
                        </div>
                        <h6 class="text-center">@Model.EntityInfo.EntityName</h6>
                        
                        <div class="mt-3">
                            @if (!string.IsNullOrEmpty(Model.EntityInfo.Email))
                            {
                                <p class="small mb-1">
                                    <i class="bi bi-envelope me-2"></i>@Model.EntityInfo.Email
                                </p>
                            }
                            @if (!string.IsNullOrEmpty(Model.EntityInfo.ContactPhone))
                            {
                                <p class="small mb-1">
                                    <i class="bi bi-telephone me-2"></i>@Model.EntityInfo.ContactPhone
                                </p>
                            }
                        </div>
                        
                        <div class="d-grid mt-3">
                            <a href="/FinancialEntity/FinancialEntityDetail?entityId=@Model.EntityInfo.ID" class="btn btn-primary">
                                <i class="bi bi-eye me-2"></i>Ver Entidad
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="py-5 bg-light">
        <div class="container text-center">
            @if (Model.IsPromotionActive())
            {
                <h3 class="mb-3 text-primary">¡Aprovecha este beneficio financiero!</h3>
                <p class="lead mb-4">Conecta tu cuenta de @Model.EntityInfo.EntityName con Yavi</p>
                <div class="d-flex justify-content-center gap-3 flex-wrap">
                    <a href="/Register/UserRegister" class="btn btn-primary btn-lg">
                        <i class="bi bi-download me-2"></i>Regístrate
                    </a>
                    <a href="/FinancialEntity/FinancialEntityDetail?entityId=@Model.EntityInfo.ID" class="btn btn-outline-primary btn-lg">
                        <i class="bi bi-bank me-2"></i>Ver Entidad
                    </a>
                </div>
            }
            else
            {
                <h3 class="mb-3 text-muted">Esta promoción no está disponible</h3>
                <p class="lead mb-4">Explora otras promociones financieras disponibles en Yavi</p>
                <a href="/" class="btn btn-primary btn-lg">
                    <i class="bi bi-bank me-2"></i>Ver Otras Promociones
                </a>
            }
        </div>
    </section>
}

@section Scripts {
    <script>
        // Smooth scrolling
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });
    </script>
}